@using System.Text.Json
@model LecturerClassVm
@{ ViewData["Title"] = Model.Class.Name; }
<a asp-action="Index" class="mb-3 btn btn-soft btn-sm">← Lớp giảng dạy</a>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div><h1>@Model.Class.Name</h1><p class="text-muted mb-1">Mã tham gia: <strong class="text-primary">@Model.Class.JoinCode</strong> · @(Model.Class.IsActive ? "Lớp đang mở" : "Lớp đã đóng")</p></div>
    <div class="d-flex flex-wrap gap-2"><a asp-action="Export" asp-route-id="@Model.Class.Id" class="btn btn-outline-primary">Xuất CSV cho Excel</a>
        @if (Model.Class.IsActive) { <a asp-action="CreateAssignment" asp-route-classId="@Model.Class.Id" class="btn btn-primary">Giao bài tập</a> }
        <form asp-action="SetActive" method="post"><input type="hidden" name="id" value="@Model.Class.Id" /><input type="hidden" name="active" value="@((!Model.Class.IsActive).ToString().ToLowerInvariant())" /><button class="btn btn-outline-secondary" type="submit">@(Model.Class.IsActive ? "Đóng lớp" : "Mở lại lớp")</button></form>
    </div>
</div>
@if (TempData["ClassMessage"] is string message) { <div class="alert alert-success" role="status">@message</div> }
@if (TempData["ClassError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Sinh viên</div><strong class="fs-2">@Model.Students.Count</strong></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Buổi hoàn thành đầy đủ</div><strong class="fs-2">@Model.CompletedCount</strong></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Trung bình /10</div><strong class="fs-2">@(Model.AverageScore?.ToString("0.0") ?? "—")</strong></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">Cần theo dõi</div><strong class="fs-2">@Model.Students.Count(s => s.Inactive || s.RepeatedLowScores)</strong></div></div></div>
</div>
<p class="small text-muted">Điểm tổng hợp sử dụng toàn bộ buổi có báo cáo đầy đủ của thành viên, có thể gồm nhiều vị trí/rubric; không dùng để xếp hạng. Buổi kết thúc sớm hoặc báo cáo tạm thời không tính vào trung bình.</p>
<h2 class="h4">Sinh viên và cảnh báo</h2>
<div class="table-responsive mb-4"><table class="table align-middle"><thead><tr><th>Sinh viên</th><th>Số buổi</th><th>TB /10</th><th>Luyện gần nhất (UTC+7)</th><th>Cảnh báo</th><th></th></tr></thead><tbody>
@foreach (var student in Model.Students)
{
    <tr><td><strong>@student.Name</strong><br /><span class="text-muted small">@student.Email</span></td><td>@student.CompletedCount</td><td>@(student.AverageScore?.ToString("0.0") ?? "—")</td><td>@ClassroomUi.Date(student.LastPracticeAt)</td>
        <td>@if (student.Inactive) { <span class="badge bg-warning text-dark mb-1">Không luyện ≥14 ngày</span> } @if (student.RepeatedLowScores) { <span class="badge bg-danger">3 buổi gần nhất &lt;5</span> } @if (!student.Inactive && !student.RepeatedLowScores) { <span class="text-muted">—</span> }</td>
        <td><a asp-action="Student" asp-route-classId="@Model.Class.Id" asp-route-studentId="@student.StudentId" class="btn btn-soft btn-sm">Lịch sử và góp ý</a></td></tr>
}
@if (Model.Students.Count == 0) { <tr><td colspan="6">Chưa có sinh viên. Chia sẻ mã lớp để sinh viên tham gia.</td></tr> }
</tbody></table></div>
<div class="row g-4 mb-4"><div class="col-lg-7"><div class="card h-100"><div class="card-body"><h2 class="h4">Kỹ năng cần củng cố của lớp</h2>
@if (Model.Skills.Count == 0) { <p class="text-muted">Chưa đủ báo cáo có chủ đề kỹ năng.</p> }
else { <div style="height:330px"><canvas id="classSkills" aria-label="Điểm trung bình theo chủ đề kỹ năng" role="img"></canvas></div><p class="small text-muted mt-2 mb-0">Từ điểm câu chính, mỗi câu được tính cho các chủ đề gắn với câu đó. Số mẫu là số câu được chấm.</p> }
</div></div></div><div class="col-lg-5"><div class="card h-100"><div class="card-body"><h2 class="h4">Chi tiết kỹ năng</h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Chủ đề</th><th>TB /10</th><th>Số mẫu</th></tr></thead><tbody>
@foreach (var skill in Model.Skills) { <tr><td>@skill.Skill</td><td>@skill.Score.ToString("0.0")</td><td>@skill.SampleCount</td></tr> }
</tbody></table></div></div></div></div></div>
<h2 class="h4">Bài tập của lớp</h2>
@foreach (var assignment in Model.Assignments)
{
    var submissions = Model.Submissions.Where(s => s.AssignmentId == assignment.Id).ToList();
    <div class="card mb-3"><div class="card-body"><div class="d-flex flex-wrap justify-content-between gap-2"><h3 class="h5">@assignment.Title</h3><span>Đã nộp: @submissions.Select(s => s.StudentId).Distinct().Count()/@Model.Students.Count sinh viên</span></div>
        <p class="text-muted mb-2">@assignment.Position.Name · @ClassroomUi.Label(assignment.Level) · @ClassroomUi.Label(assignment.Language) · @ClassroomUi.Label(assignment.Kind) · @assignment.QuestionCount câu · Hạn @ClassroomUi.Date(assignment.DueAt) (UTC+7) · Rubric #@assignment.RubricVersionId</p>
        <p style="white-space:pre-wrap">@assignment.Instructions</p>
        <details><summary>Xem tất cả lần nộp (@submissions.Count)</summary><div class="table-responsive mt-2"><table class="table table-sm"><thead><tr><th>Sinh viên</th><th>Lần</th><th>Nộp lúc (UTC+7)</th><th>Trạng thái</th><th>Điểm</th><th></th></tr></thead><tbody>
        @foreach (var submission in submissions) { <tr><td>@(Model.Students.FirstOrDefault(s => s.StudentId == submission.StudentId)?.Name ?? "Sinh viên")</td><td>@submission.AttemptNumber</td><td>@ClassroomUi.Date(submission.SubmittedAt)</td><td>@(submission.IsLate ? "Muộn" : "Đúng hạn")</td><td>@submission.Session.Evaluation?.OverallScore.ToString("0.0")/10</td><td><a href="/Interviews/Report/@submission.SessionId" class="btn btn-soft btn-sm">Báo cáo</a></td></tr> }
        </tbody></table></div></details>
    </div></div>
}
@if (Model.Assignments.Count == 0) { <p class="text-muted">Chưa giao bài tập.</p> }
@section Scripts {
<script id="classSkillData" type="application/json">@Html.Raw(JsonSerializer.Serialize(new { labels = Model.Skills.Select(s => s.Skill), scores = Model.Skills.Select(s => s.Score) }))</script>
<script>document.addEventListener('DOMContentLoaded',()=>{const el=document.getElementById('classSkills');if(!el)return;const data=JSON.parse(document.getElementById('classSkillData').textContent);new Chart(el,{type:'bar',data:{labels:data.labels,datasets:[{label:'Điểm trung bình /10',data:data.scores,backgroundColor:'#397c88'}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,scales:{x:{min:0,max:10}},plugins:{legend:{display:false}}}});});</script>
}
