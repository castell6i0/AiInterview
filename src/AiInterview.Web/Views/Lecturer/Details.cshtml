@using System.Text.Json
@model LecturerClassVm
@{ ViewData["Title"] = Model.Class.Name; var average = Ui.Score(Model.AverageScore); }
<a asp-action="Index" class="btn btn-secondary btn-back"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-back" /></svg>Lớp giảng dạy</a>
<div class="page-heading">
    <div><h1>@Model.Class.Name</h1><div class="join-code-row"><span class="join-code-label">Mã tham gia</span><strong class="join-code">@Model.Class.JoinCode</strong><button type="button" class="btn btn-secondary btn-sm btn-copy" data-copy="@Model.Class.JoinCode" title="Sao chép mã tham gia"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-copy" /></svg><span>Sao chép</span></button><span class="pill @(Model.Class.IsActive ? "pill-ok" : "pill-off")">@(Model.Class.IsActive ? "Lớp đang mở" : "Lớp đã đóng")</span></div></div>
    <div class="page-actions">@if (Model.Class.IsActive) { <a asp-action="CreateAssignment" asp-route-classId="@Model.Class.Id" class="btn btn-primary">Giao bài tập</a> }
        <a asp-action="Export" asp-route-id="@Model.Class.Id" class="btn btn-secondary">Xuất CSV cho Excel</a>
        <form asp-action="SetActive" method="post"><input type="hidden" name="id" value="@Model.Class.Id" /><input type="hidden" name="active" value="@((!Model.Class.IsActive).ToString().ToLowerInvariant())" /><button class="btn btn-secondary" type="submit">@(Model.Class.IsActive ? "Đóng lớp" : "Mở lại lớp")</button></form>
    </div>
</div>
@if (TempData["ClassMessage"] is string message) { <div class="alert alert-success" role="status">@message</div> }
@if (TempData["ClassError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<section class="page-section" aria-label="Tổng quan lớp">
<dl class="kpi-grid">
    <div class="kpi reveal" style="--i:0"><dt>Sinh viên</dt><dd><span class="kpi-value">@Model.Students.Count</span><span class="kpi-unit">người</span></dd></div>
    <div class="kpi reveal" style="--i:1"><dt>Cần theo dõi</dt><dd><span class="kpi-value">@Model.Students.Count(s => s.Inactive || s.RepeatedLowScores)</span><span class="kpi-unit">người</span></dd><dd class="kpi-hint">Không luyện từ 14 ngày, hoặc 3 buổi gần nhất dưới 5 điểm.</dd></div>
    <div class="kpi reveal" style="--i:2"><dt>Điểm trung bình</dt><dd class="score-@average.Band"><span class="kpi-value">@(Model.AverageScore?.ToString("0.0") ?? "—")</span><span class="kpi-unit">/10</span>@if (Model.AverageScore.HasValue) { <span class="score-label">@average.Label</span> }</dd><dd class="kpi-hint">Từ @Model.CompletedCount buổi có báo cáo đầy đủ; không dùng để xếp hạng.</dd></div>
</dl>
<div class="card"><div class="card-body"><h2 class="h4">Kỹ năng cần củng cố của lớp</h2>
@if (Model.Skills.Count == 0) { <div class="chart-empty"><p class="mb-3">Chưa có câu được chấm có gắn chủ đề kỹ năng. Biểu đồ xuất hiện khi sinh viên hoàn thành và nhận báo cáo cho ít nhất một buổi.</p>@if (Model.Class.IsActive) { <a asp-action="CreateAssignment" asp-route-classId="@Model.Class.Id" class="btn btn-secondary">Giao bài tập</a> }</div> }
else { <div class="chart-box" style="height:330px"><canvas id="classSkills" aria-label="Biểu đồ cột điểm trung bình theo chủ đề kỹ năng, thang 0 đến 10" role="img"></canvas></div><p class="small text-muted mt-2 mb-0">Tính từ điểm câu chính; mỗi câu được tính cho các chủ đề gắn với câu đó.</p>
    <details class="mt-3"><summary>Xem bảng số liệu</summary><div class="table-responsive mt-2"><table class="table table-sm"><thead><tr><th>Chủ đề</th><th class="num">TB /10</th><th>Mức</th><th class="num">Số mẫu</th></tr></thead><tbody>
@foreach (var skill in Model.Skills) { <tr><td>@skill.Skill</td><td class="num">@skill.Score.ToString("0.0")</td><td class="score-@Ui.Score(skill.Score).Band">@Ui.Score(skill.Score).Label</td><td class="num">@skill.SampleCount</td></tr> }
</tbody></table></div></details> }
</div></div>
</section>
<section class="page-section" aria-labelledby="studentsHeading"><h2 class="h4" id="studentsHeading">Sinh viên và cảnh báo</h2>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Sinh viên</th><th class="num">Số buổi</th><th>TB /10</th><th>Luyện gần nhất (UTC+7)</th><th>Cảnh báo</th><th></th></tr></thead><tbody>
@foreach (var student in Model.Students)
{
    <tr><td><strong>@student.Name</strong><br /><span class="text-muted small">@student.Email</span></td><td class="num">@student.CompletedCount</td><td><span class="score-value score-@Ui.Score(student.AverageScore).Band">@(student.AverageScore?.ToString("0.0") ?? "—")</span>@if (student.AverageScore.HasValue) { <span class="small text-muted"> · @Ui.Score(student.AverageScore).Label</span> }</td><td>@ClassroomUi.Date(student.LastPracticeAt)</td>
        <td>@if (student.Inactive) { <span class="pill pill-warn mb-1">Không luyện ≥14 ngày</span> } @if (student.RepeatedLowScores) { <span class="pill pill-danger">3 buổi gần nhất &lt;5</span> } @if (!student.Inactive && !student.RepeatedLowScores) { <span class="text-muted">—</span> }</td>
        <td><button type="button" class="menu-dots" popovertarget="menu-s@(student.StudentId)" style="anchor-name:--menu-s@(student.StudentId)" aria-label="Thao tác cho @student.Name"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-more-v" /></svg></button><div id="menu-s@(student.StudentId)" popover class="glass-pop row-menu" style="position-anchor:--menu-s@(student.StudentId)"><a asp-action="Student" asp-route-classId="@Model.Class.Id" asp-route-studentId="@student.StudentId" class="row-menu-item"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-history" /></svg>Lịch sử và góp ý</a><form asp-action="Kick" method="post" data-confirm="Mời @student.Name ra khỏi lớp? Sinh viên sẽ không thể dùng mã để vào lại; bài đã nộp vẫn được giữ."><input type="hidden" name="classId" value="@Model.Class.Id" /><input type="hidden" name="studentId" value="@student.StudentId" /><button type="submit" class="row-menu-item is-danger"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-user-x" /></svg>Mời khỏi lớp</button></form></div></td></tr>
}
@if (Model.Students.Count == 0) { <tr><td colspan="6">Chưa có sinh viên. Gửi mã <strong class="join-code">@Model.Class.JoinCode</strong> để sinh viên nhập ở mục Lớp của tôi.</td></tr> }
</tbody></table></div>
</section>
<h2 class="h4">Bài tập của lớp</h2>
@foreach (var assignment in Model.Assignments)
{
    var submissions = Model.Submissions.Where(s => s.AssignmentId == assignment.Id).ToList();
    <div class="card mb-3"><div class="card-body"><div class="d-flex flex-wrap justify-content-between gap-2"><h3 class="h5">@assignment.Title</h3><span>Đã nộp: @submissions.Select(s => s.StudentId).Distinct().Count()/@Model.Students.Count sinh viên</span></div>
        <p class="text-muted mb-2">@assignment.Position.Name · @ClassroomUi.Label(assignment.Level) · @ClassroomUi.Label(assignment.Language) · @ClassroomUi.Label(assignment.Kind) · @assignment.QuestionCount câu · Hạn @ClassroomUi.Date(assignment.DueAt) (UTC+7) · Rubric #@assignment.RubricVersionId</p>
        <p class="preserve">@assignment.Instructions</p>
        <details><summary>Xem tất cả lần nộp (@submissions.Count)</summary><div class="table-responsive mt-2"><table class="table table-sm"><thead><tr><th>Sinh viên</th><th>Lần</th><th>Nộp lúc (UTC+7)</th><th>Trạng thái</th><th>Điểm</th><th></th></tr></thead><tbody>
        @foreach (var submission in submissions) { var member = Model.Students.FirstOrDefault(s => s.StudentId == submission.StudentId); <tr><td>@(member?.Name ?? "Sinh viên") @if (member is null) { <span class="pill pill-off">Đã rời lớp</span> }</td><td>@submission.AttemptNumber</td><td>@ClassroomUi.Date(submission.SubmittedAt)</td><td><span class="pill @(submission.IsLate ? "pill-warn" : "pill-ok")">@(submission.IsLate ? "Muộn" : "Đúng hạn")</span></td><td><span class="score-value score-@Ui.Score(submission.Session.Evaluation?.OverallScore).Band">@(submission.Session.Evaluation?.OverallScore.ToString("0.0") ?? "—")/10</span></td><td><a href="/Interviews/Report/@submission.SessionId" class="btn btn-secondary btn-sm">Báo cáo</a>@if (member is null) { <details class="mt-2"><summary class="small">Nhận xét</summary><form asp-action="Comment" method="post" class="mt-2"><input type="hidden" name="ClassId" value="@Model.Class.Id" /><input type="hidden" name="SessionId" value="@submission.SessionId" /><label for="comment-@submission.Id" class="visually-hidden">Nội dung nhận xét</label><textarea id="comment-@submission.Id" name="Content" class="form-control mb-2" rows="2" maxlength="3000" required></textarea><button type="submit" class="btn btn-secondary btn-sm">Lưu nhận xét</button></form></details> }</td></tr> }
        </tbody></table></div></details>
    </div></div>
}
@if (Model.Assignments.Count == 0) { <p class="text-muted">Chưa giao bài tập.</p> }
@section Scripts {
<script id="classSkillData" type="application/json">@Html.Raw(JsonSerializer.Serialize(new { labels = Model.Skills.Select(s => s.Skill), scores = Model.Skills.Select(s => s.Score), bands = Model.Skills.Select(s => Ui.Score(s.Score).Band) }))</script>
<script>document.addEventListener('DOMContentLoaded',()=>{const el=document.getElementById('classSkills');if(!el||!window.Chart||!window.ChartTheme)return;const data=JSON.parse(document.getElementById('classSkillData').textContent);const tone={low:'--danger',mid:'--warn',good:'--cyan',top:'--accent'};new Chart(el,{type:'bar',data:{labels:data.labels,datasets:[{label:'Điểm trung bình /10',data:data.scores,backgroundColor:data.bands.map(b=>ChartTheme.token(tone[b])),borderRadius:3}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,scales:{x:{min:0,max:10,ticks:{stepSize:2},title:{display:true,text:'Điểm trung bình (/10)'}},y:{title:{display:true,text:'Chủ đề kỹ năng'}}},plugins:{legend:{display:false}}}});});</script>
}
