@using System.Text.Json
@model LecturerStudentVm
@{
    ViewData["Title"] = Model.Student.Name;
    var completed = Model.Sessions.Where(s => s.Status == SessionStatus.Completed && s.Evaluation is { IsProvisional: false }).OrderBy(s => s.CreatedAt).ToList();
    var groups = completed.GroupBy(s => new { s.PositionId, s.RubricVersionId, s.Level, s.Language });
    var chartData = new { labels = completed.Select(s => ClassroomUi.Date(s.CreatedAt)), datasets = groups.Select(g => new { label = $"{g.First().Position.Name} · {ClassroomUi.Label(g.Key.Level)} · {ClassroomUi.Label(g.Key.Language)} · Rubric {g.Key.RubricVersionId}", data = completed.Select(s => s.PositionId == g.Key.PositionId && s.RubricVersionId == g.Key.RubricVersionId && s.Level == g.Key.Level && s.Language == g.Key.Language ? (decimal?)s.Evaluation!.OverallScore : null), spanGaps = true, tension = 0.15 }) };
}
<a asp-action="Details" asp-route-id="@Model.Class.Id" class="mb-3 btn btn-soft btn-sm">← @Model.Class.Name</a>
<h1>@Model.Student.Name</h1><p class="text-muted">@Model.Student.Email · Tham gia lớp @ClassroomUi.Date(Model.Student.JoinedAt)</p>
@if (TempData["ClassMessage"] is string message) { <div class="alert alert-success" role="status">@message</div> }
@if (TempData["ClassError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<div class="card mb-4"><div class="card-body"><h2 class="h4">Tiến bộ qua các buổi</h2>
    @if (completed.Count == 0) { <p class="text-muted">Chưa có buổi hoàn thành đầy đủ để vẽ biểu đồ.</p> }
    else { <div style="height:330px"><canvas id="studentProgress" aria-label="Biểu đồ điểm phỏng vấn của sinh viên" role="img"></canvas></div><p class="small text-muted mt-2 mb-0">Tách đường theo vị trí, cấp độ, ngôn ngữ và rubric. Báo cáo tạm thời không nằm trong biểu đồ.</p> }
</div></div>
<h2 class="h4">Lịch sử phỏng vấn và nhận xét</h2>
@foreach (var session in Model.Sessions)
{
    var comments = Model.Comments.Where(c => c.SessionId == session.Id).ToList();
    <div class="card mb-3"><div class="card-body">
        <div class="d-flex flex-wrap justify-content-between gap-2"><div><h3 class="h5">@session.Position.Name · @ClassroomUi.Label(session.Kind)</h3><p class="text-muted mb-2">@ClassroomUi.Date(session.CreatedAt) (UTC+7) · @ClassroomUi.Label(session.Language) · @ClassroomUi.Label(session.Level)</p></div>
            <div class="text-end"><span class="badge bg-light text-dark">@ClassroomUi.Label(session.Status)</span>
                @if (session.Evaluation is not null) { <p class="mt-2 mb-1"><strong>@session.Evaluation.OverallScore.ToString("0.0")/10</strong> @(session.Evaluation.IsProvisional ? "(tạm thời)" : "")</p><a href="/Interviews/Report/@session.Id" class="btn btn-soft btn-sm">Xem báo cáo chi tiết</a> }
            </div>
        </div>
        @foreach (var comment in comments) { <div class="border-start border-3 ps-3 py-1 my-2"><p class="mb-1" style="white-space:pre-wrap">@comment.Content</p><small class="text-muted">@ClassroomUi.Date(comment.CreatedAt) (UTC+7)</small></div> }
        <details class="mt-3"><summary>Thêm nhận xét cho sinh viên</summary><form asp-action="Comment" method="post" class="mt-2">
            <input type="hidden" name="ClassId" value="@Model.Class.Id" /><input type="hidden" name="SessionId" value="@session.Id" />
            <label for="comment-@session.Id" class="form-label">Nội dung nhận xét</label><textarea id="comment-@session.Id" name="Content" class="form-control mb-2" rows="3" maxlength="3000" required></textarea><button type="submit" class="btn btn-outline-primary btn-sm">Lưu nhận xét</button>
        </form></details>
    </div></div>
}
@if (Model.Sessions.Count == 0) { <p>Sinh viên chưa có buổi luyện tập.</p> }
@section Scripts {
<script id="studentChartData" type="application/json">@Html.Raw(JsonSerializer.Serialize(chartData))</script>
<script>document.addEventListener('DOMContentLoaded',()=>{const el=document.getElementById('studentProgress');if(!el)return;new Chart(el,{type:'line',data:JSON.parse(document.getElementById('studentChartData').textContent),options:{responsive:true,maintainAspectRatio:false,scales:{y:{min:0,max:10,title:{display:true,text:'Điểm /10'}}},plugins:{legend:{position:'bottom'}}}});});</script>
}
