@model AssignmentEditVm
@{ ViewData["Title"] = "Giao bài phỏng vấn"; }
<a asp-action="Details" asp-route-id="@Model.ClassId" class="page-back">← Dashboard lớp</a><h1>Giao bài phỏng vấn</h1>
<div class="card"><div class="card-body"><form asp-action="CreateAssignment" method="post">
    <input asp-for="ClassId" type="hidden" /><div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="DueAtVietnam" class="form-label"></label><input asp-for="DueAtVietnam" type="datetime-local" class="form-control" asp-format="{0:yyyy-MM-ddTHH:mm}" /></div>
        <div class="col-12"><label asp-for="Instructions" class="form-label"></label><textarea asp-for="Instructions" class="form-control" rows="4"></textarea></div>
        <div class="col-md-6"><label asp-for="PositionId" class="form-label"></label><select asp-for="PositionId" class="form-select" asp-items="@(new SelectList(Model.Positions, "Id", "Name"))"><option value="">Chọn vị trí</option></select></div>
        <div class="col-md-3"><label asp-for="Level" class="form-label">Cấp độ</label><select asp-for="Level" class="form-select" asp-items="ClassroomUi.Options<InterviewLevel>()"></select></div>
        <div class="col-md-3"><label asp-for="Language" class="form-label">Ngôn ngữ</label><select asp-for="Language" class="form-select" asp-items="ClassroomUi.Options<InterviewLanguage>()"></select></div>
        <div class="col-md-8"><label asp-for="Kind" class="form-label">Loại phỏng vấn</label><select asp-for="Kind" class="form-select" asp-items="ClassroomUi.Options<InterviewKind>()"></select></div>
        <div class="col-md-4"><label asp-for="QuestionCount" class="form-label"></label><input asp-for="QuestionCount" type="number" min="5" max="10" class="form-control" /></div>
        <div class="col-12"><div class="alert alert-info mb-0">Bài tập giữ rubric đang hoạt động tại thời điểm giao. Với bài theo CV hoặc JD, sinh viên chọn tài liệu của mình khi tạo buổi. Bài nộp muộn vẫn được lưu và có nhãn riêng.</div></div>
        <div class="col-12"><button class="btn btn-primary" type="submit">Giao bài cho cả lớp</button></div>
    </div>
</form></div></div>
