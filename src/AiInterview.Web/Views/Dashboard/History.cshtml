@model HistoryModel
@{ ViewData["Title"] = "Lịch sử luyện tập"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1>Lịch sử luyện tập</h1><p class="text-muted mb-0">Xem lại câu trả lời, đọc phản hồi và so sánh hai buổi.</p></div><a asp-controller="Interviews" asp-action="Create" class="btn btn-primary">Tạo buổi mới</a></div>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<form asp-action="History" method="get" class="card mb-4"><div class="card-body"><div class="row g-3 align-items-end">
    <div class="col-md-4"><label asp-for="PositionId" class="form-label">Vị trí</label><select asp-for="PositionId" class="form-select"><option value="">Tất cả vị trí</option>@foreach (var position in Model.Positions) { <option value="@position.Id">@position.Name</option> }</select></div>
    <div class="col-md-4"><label asp-for="Language" class="form-label">Ngôn ngữ</label><select asp-for="Language" class="form-select"><option value="">Cả hai ngôn ngữ</option>@foreach (var value in Enum.GetValues<InterviewLanguage>()) { <option value="@value">@Ui.Label(value)</option> }</select></div>
    <div class="col-md-4"><label asp-for="Status" class="form-label">Trạng thái</label><select asp-for="Status" class="form-select"><option value="">Tất cả trạng thái</option>@foreach (var value in Enum.GetValues<SessionStatus>()) { <option value="@value">@Ui.Label(value)</option> }</select></div>
    <div class="col-md-4"><label asp-for="From" class="form-label">Từ ngày (UTC+7)</label><input asp-for="From" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" /></div>
    <div class="col-md-4"><label asp-for="To" class="form-label">Đến ngày (UTC+7)</label><input asp-for="To" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" /></div>
    <div class="col-md-4 support-actions"><button type="submit" class="btn btn-primary">Lọc lịch sử</button><a asp-action="History" class="btn btn-secondary btn-sm">Xóa bộ lọc</a></div>
</div></div></form>
@if (Model.Sessions.Count == 0) { <div class="card"><div class="card-body p-4"><p>Không có buổi nào trong bộ lọc này. Bạn có thể xem tất cả hoặc tạo một buổi mới.</p><div class="support-actions"><a asp-controller="Interviews" asp-action="Create" class="btn btn-primary btn-sm">Tạo buổi mới</a><a asp-action="History" class="btn btn-secondary btn-sm">Xem tất cả</a></div></div></div> }
else {
    <p class="small text-muted">@Model.TotalCount buổi · Trang @Model.Page / @Model.PageCount</p>
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Buổi luyện</th><th>Bối cảnh</th><th>Trạng thái</th><th>Điểm /10</th><th><span class="visually-hidden">Thao tác</span></th></tr></thead><tbody>
    @foreach (var session in Model.Sessions) { var band = Ui.Score(session.Evaluation?.OverallScore); <tr><td><strong>@session.Position.Name</strong><div class="small text-muted">@Ui.Time(session.CreatedAt) (UTC+7)</div></td><td>@session.Level · @Ui.Label(session.Language)<div class="small text-muted">@Ui.Label(session.Kind) · @Ui.Label(session.Mode)</div></td><td>@Ui.Label(session.Status)@if (session.Evaluation?.IsProvisional == true) { <div class="small text-warning">Kết quả tạm thời · @session.Evaluation.CompletionRate.ToString("0")% hoàn thành</div> }</td><td><span class="score-line score-@band.Band"><span class="score-value">@(session.Evaluation?.OverallScore.ToString("0.00") ?? "—")</span>@if (session.Evaluation is not null) { <span class="score-label">@band.Label</span> }</span><div class="small text-muted">@(session.Evaluation?.Verdict ?? "")</div></td><td><div class="d-flex flex-wrap gap-2"><a asp-controller="Interviews" asp-action="@(session.Status == SessionStatus.Completed ? "Report" : "Room")" asp-route-id="@session.Id" class="btn btn-sm btn-secondary">@(session.Status == SessionStatus.Completed ? "Báo cáo" : "Tiếp tục")</a><a asp-controller="Interviews" asp-action="Replay" asp-route-id="@session.Id" class="btn btn-sm btn-secondary">Timeline</a></div></td></tr> }
    </tbody></table></div>
    <nav class="d-flex justify-content-between my-3" aria-label="Phân trang lịch sử">
        @if (Model.Page > 1) { <a asp-action="History" asp-route-page="@(Model.Page - 1)" asp-route-positionId="@Model.PositionId" asp-route-language="@Model.Language" asp-route-status="@Model.Status" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" class="btn btn-secondary">← Trang trước</a> } else { <span></span> }
        @if (Model.Page < Model.PageCount) { <a asp-action="History" asp-route-page="@(Model.Page + 1)" asp-route-positionId="@Model.PositionId" asp-route-language="@Model.Language" asp-route-status="@Model.Status" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" class="btn btn-secondary">Trang sau →</a> }
    </nav>
    @if (Model.Sessions.Count >= 2) { <section class="card mt-4"><div class="card-body p-4"><h2 class="h4">So sánh hai buổi trên trang này</h2><p class="text-muted">Ưu tiên cùng vị trí, cấp độ, ngôn ngữ và mức hoàn thành để diễn giải đúng sự tiến bộ.</p><form asp-controller="Interviews" asp-action="Compare" method="get"><div class="row g-3"><div class="col-md-5"><label for="left" class="form-label">Buổi thứ nhất</label><select id="left" name="left" class="form-select" required>@foreach (var session in Model.Sessions) { <option value="@session.Id">@session.Position.Name · @Ui.Time(session.CreatedAt) · @session.Level</option> }</select></div><div class="col-md-5"><label for="right" class="form-label">Buổi thứ hai</label><select id="right" name="right" class="form-select" required>@foreach (var session in Model.Sessions) { <option value="@session.Id" selected="@(session == Model.Sessions[1])">@session.Position.Name · @Ui.Time(session.CreatedAt) · @session.Level</option> }</select></div><div class="col-md-2 align-self-end"><button type="submit" class="btn btn-primary w-100">So sánh</button></div></div></form></div></section> }
}
