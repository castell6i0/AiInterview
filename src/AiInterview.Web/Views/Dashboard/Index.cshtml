@model DashboardModel
@{ ViewData["Title"] = "Góc luyện tập"; var resume = Model.Recent.FirstOrDefault(s => s.Status != SessionStatus.Completed); var average = Ui.Score(Model.AverageScore); var hasDelivery = Model.Progress.Any(x => x.WordCount.HasValue); var weak = Model.Skills.Take(3).ToList(); }
<div class="page-heading"><div><h1>Góc luyện tập</h1></div></div>
@if (TempData["DashboardError"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }

@* 1 · Việc nên làm tiếp: khối nổi nhất, một nút chính. *@
<section class="dashboard-hero" aria-labelledby="nextPracticeHeading">
    <div class="dashboard-hero-copy"><span class="eyebrow">BƯỚC TIẾP THEO</span>
        @if (!ActiveAi.IsConfigured) {
            <h2 id="nextPracticeHeading">Kết nối AI để bắt đầu luyện tập</h2><p>Dán API key Gemini hoặc OpenAI trong Cài đặt AI, rồi tạo buổi luyện đầu tiên.</p>
        } else if (resume is not null) {
            <h2 id="nextPracticeHeading">Tiếp tục buổi luyện còn dở</h2><p>@resume.Position.Name · @Ui.Label(resume.Level) · @Ui.Label(resume.Language). Câu trả lời đã gửi vẫn được giữ.</p>
        } else {
            <h2 id="nextPracticeHeading">Bắt đầu một buổi phỏng vấn mới</h2><p>Chọn vị trí, trả lời 5 câu và nhận góp ý cụ thể.</p>
        }
        @if (!Model.HasAnySessions) {
            <ol class="hero-steps" aria-label="Ba bước cho buổi đầu tiên">
                <li class="@(ActiveAi.IsConfigured ? "is-done" : "is-current")">Kết nối AI</li>
                <li class="@(ActiveAi.IsConfigured ? "is-current" : "")">Tạo buổi luyện</li>
                <li>Xem báo cáo</li>
            </ol>
        }
    </div>
    <div class="dashboard-hero-action">
        @if (!ActiveAi.IsConfigured) {
            <a asp-controller="AiSettings" asp-action="Index" asp-route-returnUrl="/Interviews/Create" class="btn btn-primary">Kết nối AI <span class="btn-arrow" aria-hidden="true">→</span></a>
            @if (resume is not null) { <a asp-controller="Interviews" asp-action="Room" asp-route-id="@resume.Id" class="btn btn-secondary">Mở buổi đang dở</a> }
            else { <a asp-controller="Profile" asp-action="Index" class="btn btn-secondary">Chuẩn bị hồ sơ trước</a> }
        }
        else if (resume is not null) { <a asp-controller="Interviews" asp-action="Room" asp-route-id="@resume.Id" class="btn btn-primary">Tiếp tục buổi luyện <span class="btn-arrow" aria-hidden="true">→</span></a><a asp-controller="Interviews" asp-action="Create" class="btn btn-secondary">Tạo buổi mới</a> }
        else { <a asp-controller="Interviews" asp-action="Create" class="btn btn-primary">Tạo buổi luyện <span class="btn-arrow" aria-hidden="true">→</span></a><a asp-controller="Profile" asp-action="Index" class="btn btn-secondary">Chuẩn bị CV & JD</a> }
    </div>
</section>

@* 2 · Số liệu tóm tắt: bộ lọc áp dụng cho cả trang. *@
<section id="progress" class="page-section" aria-labelledby="progressTitle">
    <div class="section-head"><h2 class="h4 mb-0" id="progressTitle">Tiến bộ</h2></div>
    <form asp-action="Index" method="get" class="filter-bar mb-3" aria-label="Lọc theo bối cảnh luyện"><div class="row g-2 align-items-end">
        <div class="col-md-3"><label asp-for="PositionId" class="form-label">Vị trí</label><select asp-for="PositionId" class="form-select form-select-sm"><option value="">Tất cả vị trí</option>@foreach (var position in Model.Positions) { <option value="@position.Id">@position.Name</option> }</select></div>
        <div class="col-6 col-md-3"><label asp-for="Language" class="form-label">Ngôn ngữ</label><select asp-for="Language" class="form-select form-select-sm"><option value="">Cả hai ngôn ngữ</option>@foreach (var value in Enum.GetValues<InterviewLanguage>()) { <option value="@value">@Ui.Label(value)</option> }</select></div>
        <div class="col-6 col-md-3"><label asp-for="Level" class="form-label">Cấp độ</label><select asp-for="Level" class="form-select form-select-sm"><option value="">Cả hai cấp độ</option>@foreach (var value in Enum.GetValues<InterviewLevel>()) { <option value="@value">@value</option> }</select></div>
        <div class="col-md-3"><button type="submit" class="btn btn-secondary btn-sm w-100">Áp dụng bộ lọc</button></div>
    </div></form>
    <dl class="kpi-grid">
        <div class="kpi reveal" style="--i:0"><dt>Buổi luyện</dt><dd><span class="kpi-value">@Model.TotalSessions</span><span class="kpi-unit">buổi</span></dd><dd class="kpi-hint">@Model.CompletedSessions buổi đã có báo cáo.</dd></div>
        <div class="kpi reveal" style="--i:1"><dt>Buổi đầy đủ</dt><dd><span class="kpi-value">@Model.FullEvaluatedSessions</span><span class="kpi-unit">buổi</span></dd><dd class="kpi-hint">Trả lời đủ câu chính; dùng cho biểu đồ.</dd></div>
        <div class="kpi reveal" style="--i:2"><dt>Điểm trung bình</dt><dd class="score-@average.Band"><span class="kpi-value">@(Model.AverageScore?.ToString("0.0") ?? "—")</span><span class="kpi-unit">/10</span>@if (Model.AverageScore.HasValue) { <span class="score-label">@average.Label</span> }</dd><dd class="kpi-hint">Tính trên các buổi đầy đủ.</dd></div>
    </dl>
    <div class="row g-4">
        <div class="@(hasDelivery ? "col-xl-6" : "col-12")"><section class="card h-100" aria-labelledby="progressHeading"><div class="card-body">
            <h3 id="progressHeading" class="h5">Điểm qua từng buổi</h3>
            <p class="text-muted small">Tối đa 100 buổi đầy đủ gần nhất, mỗi đường là một bối cảnh.</p>
            @if (Model.Progress.Count == 0) {
                <div class="chart-empty"><p class="mb-0">Chưa có buổi đầy đủ để vẽ biểu đồ. Trả lời đủ mọi câu chính và tạo báo cáo cho một buổi.</p></div>
            }
            else {
                <div class="chart-box" style="height:260px"><canvas id="scoreChart" aria-label="Biểu đồ điểm nội dung theo ngày, thang 0 đến 10" role="img"></canvas></div>
                <details class="mt-3"><summary>Xem bảng số liệu</summary><div class="table-responsive mt-2"><table class="table table-sm"><thead><tr><th>Ngày (UTC+7)</th><th>Bối cảnh</th><th class="num">Điểm /10</th><th>Mức</th></tr></thead><tbody>@foreach (var point in Model.Progress) { var band = Ui.Score(point.Score); <tr><td><a asp-controller="Interviews" asp-action="Report" asp-route-id="@point.Id">@point.Date</a></td><td>@point.Position</td><td class="num">@point.Score.ToString("0.00")</td><td class="score-@band.Band">@band.Label</td></tr> }</tbody></table></div></details>
            }
        </div></section></div>
        @if (hasDelivery) {
        <div class="col-xl-6"><section class="card h-100" aria-labelledby="deliveryHeading"><div class="card-body"><div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2"><h3 id="deliveryHeading" class="h5 mb-0">Cách nói & độ dài câu trả lời</h3><div><label for="deliveryMetric" class="visually-hidden">Chỉ số cách nói</label><select id="deliveryMetric" class="form-select form-select-sm"><option value="wordsPerMinute">Tốc độ — từ/phút</option><option value="thinkingSeconds">Thời gian suy nghĩ — giây</option><option value="fillerCount">Từ đệm — trung bình/câu</option><option value="longPauseCount">Dừng dài — trung bình/câu</option><option value="wordCount">Độ dài — từ/câu</option></select></div></div><p class="text-muted small">Ước tính từ transcript; không tính vào điểm nội dung.</p><div class="chart-box" style="height:260px"><canvas id="deliveryChart" role="img" aria-label="Biểu đồ xu hướng chỉ số cách nói theo ngày"></canvas></div>
            <details class="mt-3"><summary>Xem bảng số liệu</summary><div class="table-responsive mt-2"><table class="table table-sm"><thead><tr><th>Ngày (UTC+7)</th><th>Bối cảnh</th><th class="num">Từ/phút</th><th class="num">Nghĩ (giây)</th><th class="num">Từ đệm/câu</th><th class="num">Dừng dài/câu</th><th class="num">Từ/câu</th></tr></thead><tbody>@foreach (var point in Model.Progress) { <tr><td>@point.Date</td><td>@point.Position</td><td class="num">@(point.WordsPerMinute?.ToString("0.0") ?? "—")</td><td class="num">@(point.ThinkingSeconds?.ToString("0.0") ?? "—")</td><td class="num">@(point.FillerCount?.ToString("0.0") ?? "—")</td><td class="num">@(point.LongPauseCount?.ToString("0.0") ?? "—")</td><td class="num">@(point.WordCount?.ToString("0") ?? "—")</td></tr> }</tbody></table></div></details>
        </div></section></div>
        }
    </div>
</section>

@* 3 · Kỹ năng: ba chủ đề yếu nhất dẫn thẳng tới buổi luyện điểm yếu; bản đồ đầy đủ thu gọn bên dưới. *@
<section id="practice" class="page-section card" aria-labelledby="practiceHeading"><div class="card-body">
    <div class="section-head"><h2 id="practiceHeading" class="h4 mb-0">Luyện điểm yếu</h2>@if (Model.Skills.Count > 0) { <span class="small text-muted">@Model.Skills.Count chủ đề đã chấm</span> }</div>
    @if (weak.Count == 0) {
        <p class="text-muted mb-0">Hoàn thành và tạo báo cáo cho một buổi để thấy điểm theo chủ đề.</p>
    } else {
        <div class="practice-layout">
            <div>
                <h3 class="h6">Ưu tiên ôn</h3>
                <ul class="skill-grid">@foreach (var skill in weak) { var band = Ui.Score(skill.Score); <li class="skill-chip"><span class="skill-name" title="@skill.Skill">@skill.Skill</span><span class="score-value score-@band.Band">@skill.Score.ToString("0.0")</span><span class="skill-meta"><span class="score-@band.Band">@band.Label</span> · @skill.AnswerCount lượt</span></li> }</ul>
                <p class="small text-muted mt-3 mb-0">Mỗi chủ đề: dành 20 phút @(weak[0].Score < 5 ? "ôn khái niệm cốt lõi, viết hai ví dụ đúng và một lỗi thường gặp" : "bổ sung trường hợp biên và đánh đổi cho một ví dụ trong dự án của bạn"), rồi trả lời lại một câu trong 2 phút và so với phản hồi trước.</p>
            </div>
            <div class="practice-form">
                <h3 class="h6">Tạo buổi 5 câu theo điểm yếu</h3>
                @if (!ActiveAi.IsConfigured) {
                    <p class="text-muted small mb-0">Cần kết nối AI để tạo buổi này — dùng nút ở khối Bước tiếp theo.</p>
                } else {
                <form asp-action="PracticeWeak" method="post"><input type="hidden" name="Practice.ConsentedProvider" value="@ActiveAi.Provider" />
                    <div class="mb-2"><label asp-for="Practice.PositionId" class="form-label">Vị trí luyện</label><select asp-for="Practice.PositionId" class="form-select" required>@foreach (var position in Model.Positions) { <option value="@position.Id">@position.Name</option> }</select></div>
                    <div class="row g-2"><div class="col-6"><label asp-for="Practice.Level" class="form-label">Cấp độ</label><select asp-for="Practice.Level" class="form-select">@foreach (var level in Enum.GetValues<InterviewLevel>()) { <option value="@level">@level</option> }</select></div>
                    <div class="col-6"><label asp-for="Practice.Language" class="form-label">Ngôn ngữ</label><select asp-for="Practice.Language" class="form-select">@foreach (var language in Enum.GetValues<InterviewLanguage>()) { <option value="@language">@Ui.Label(language)</option> }</select></div></div>
                    <div class="form-check my-3"><input asp-for="Practice.Consent" class="form-check-input" required /><label asp-for="Practice.Consent" class="form-check-label small">Tôi đồng ý gửi câu trả lời trong buổi luyện mới tới @ActiveAi.Provider để sinh câu hỏi và chấm điểm.</label></div>
                    <button type="submit" class="btn btn-primary w-100">Luyện điểm yếu — 5 câu</button>
                </form>
                }
            </div>
        </div>
        @if (Model.Skills.Count > weak.Count) {
            <details class="practice-more"><summary>Bản đồ kỹ năng (@Model.Skills.Count chủ đề)</summary><p class="text-muted small mt-2">Điểm trung bình các lượt trả lời gắn chủ đề, gồm câu hỏi tiếp. Số lượt là lượng bằng chứng, không phải chứng nhận.</p>
                <ul class="skill-grid">@foreach (var skill in Model.Skills) { var band = Ui.Score(skill.Score); <li class="skill-chip"><span class="skill-name" title="@skill.Skill">@skill.Skill</span><span class="score-value score-@band.Band">@skill.Score.ToString("0.0")</span><span class="skill-meta"><span class="score-@band.Band">@band.Label</span> · @skill.AnswerCount lượt</span></li> }</ul>
            </details>
        }
    }
    @if (Model.Recommendations.Count > 0) {
        <details class="practice-more"><summary>Câu hỏi trong ngân hàng nên ôn (@Model.Recommendations.Count)</summary>
            <div class="skill-grid mt-3">@foreach (var question in Model.Recommendations) { <div class="skill-cell"><p class="small text-muted mb-1">#@question.Id · @question.Position · @question.Level · @Ui.Label(question.Language) · @Ui.Label(question.Kind)</p><p class="mb-2">@question.Content</p><div class="d-flex flex-wrap gap-1">@foreach (var tag in question.Skills) { <span class="tag">@tag</span> }</div></div> }</div>
        </details>
    }
</div></section>

@* 4 · Danh sách chi tiết. *@
<section id="recent" class="page-section" aria-labelledby="recentHeading">
    <div class="section-head"><h2 id="recentHeading" class="h4 mb-0">Buổi gần đây</h2><a asp-action="History" class="btn btn-secondary btn-sm">Toàn bộ lịch sử & so sánh <span class="btn-arrow" aria-hidden="true">→</span></a></div>
    @if (Model.Recent.Count == 0) { <p class="text-muted">@(Model.HasAnySessions ? "Chưa có buổi trong bộ lọc này." : "Buổi luyện đầu tiên của bạn sẽ xuất hiện tại đây.")</p> }
    else { var index = 0;
        <ul class="session-list">@foreach (var session in Model.Recent) { var band = Ui.Score(session.Evaluation?.OverallScore); var done = session.Status == SessionStatus.Completed; var tone = done ? "pill-ok" : session.Status == SessionStatus.ReadyForEvaluation ? "pill-warn" : "pill-off";
            <li class="reveal" style="--i:@(index++)">
                <div class="session-main"><div class="session-title"><strong>@session.Position.Name</strong><span class="pill @tone">@Ui.Label(session.Status)</span></div><span class="session-meta">@session.Level · @Ui.Label(session.Language) · @Ui.Time(session.CreatedAt)</span></div>
                <div class="session-score">@if (session.Evaluation is not null) { <span class="score-line score-@band.Band"><span class="score-value">@session.Evaluation.OverallScore.ToString("0.0")</span><span class="kpi-unit">/10</span><span class="score-label">@band.Label@(session.Evaluation.IsProvisional ? " · Tạm thời" : "")</span></span> } else { <span class="text-muted small">Chưa có điểm</span> }</div>
                <a asp-controller="Interviews" asp-action="@(done ? "Report" : "Room")" asp-route-id="@session.Id" class="btn btn-sm btn-secondary">@(done ? "Xem báo cáo" : "Tiếp tục buổi")</a>
            </li> }</ul>
    }
</section>
@section Scripts {
    <script id="progressData" type="application/json">@Html.Raw(AiPrompts.Json(Model.Progress))</script>
    <script>
    (() => {
        if (typeof Chart === 'undefined' || !window.ChartTheme) return;
        const points = JSON.parse(document.getElementById('progressData').textContent);
        const contexts = [...new Set(points.map(p => p.position))];
        const datasets = metric => contexts.map((context, index) => ({ label: context, data: points.map(p => p.position === context ? p[metric] : null), tension: .2, spanGaps: true, ...ChartTheme.series(index) }));
        const xAxis = { title: { display: true, text: 'Ngày (UTC+7)' } };
        const legend = { display: contexts.length > 1, position: 'bottom' };
        const score = document.getElementById('scoreChart');
        if (score) new Chart(score, { type: 'line', data: { labels: points.map(p => p.date), datasets: datasets('score') }, options: { maintainAspectRatio: false, scales: { x: xAxis, y: { min: 0, max: 10, ticks: { stepSize: 2 }, title: { display: true, text: 'Điểm nội dung (/10)' } } }, plugins: { legend } } });
        const delivery = document.getElementById('deliveryChart');
        if (delivery) {
            const select = document.getElementById('deliveryMetric');
            select.value = points.some(p => p.wordsPerMinute !== null) ? 'wordsPerMinute' : 'wordCount';
            const yTitle = () => select.options[select.selectedIndex].text;
            const chart = new Chart(delivery, { type: 'line', data: { labels: points.map(p => p.date), datasets: datasets(select.value) }, options: { maintainAspectRatio: false, scales: { x: xAxis, y: { beginAtZero: true, title: { display: true, text: yTitle() } } }, plugins: { legend } } });
            select.addEventListener('change', event => { chart.data.datasets = datasets(event.target.value); chart.options.scales.y.title.text = yTitle(); chart.update(); });
        }
    })();
    </script>
}
