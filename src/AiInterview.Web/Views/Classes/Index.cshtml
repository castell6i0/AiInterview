@model ClassListVm
@{ ViewData["Title"] = "Lớp học của tôi"; }
<div class="page-heading"><div><h1>Lớp học của tôi</h1><p>Luyện theo bài giảng viên giao và nhận góp ý.</p></div></div>
<div class="row g-4">
    <section class="col-lg-7" aria-labelledby="classListHeading">
        <div class="section-head"><h2 id="classListHeading" class="h4 mb-0">Lớp đã tham gia</h2></div>
        @if (Model.Classes.Count == 0) { <div class="card"><div class="card-body text-muted">Bạn chưa tham gia lớp nào. Nhập mã lớp do giảng viên cung cấp.</div></div> }
        else {
            <ul class="session-list">@foreach (var classroom in Model.Classes) {
                <li><div class="session-main"><div class="session-title"><strong>@classroom.Name</strong><span class="pill @(classroom.IsActive ? "pill-ok" : "pill-off")">@(classroom.IsActive ? "Đang mở" : "Đã đóng")</span></div></div><span></span>
                <a asp-action="Details" asp-route-id="@classroom.Id" class="btn btn-secondary btn-sm">Xem bài tập</a></li> }</ul>
        }
    </section>
    <section class="col-lg-5" aria-labelledby="joinHeading"><div class="card"><div class="card-body">
        <h2 id="joinHeading" class="h4">Tham gia lớp</h2>
        <form asp-action="Join" method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="mb-3"><label asp-for="Join.Code" class="form-label"></label><input asp-for="Join.Code" class="form-control text-uppercase" placeholder="Mã từ giảng viên" autocomplete="off" /></div>
            <div class="alert alert-info small">Giảng viên của lớp sẽ xem được toàn bộ lịch sử luyện tập, transcript, điểm và tiến bộ của bạn, kể cả các buổi trước khi vào lớp. Giảng viên không tải được tệp CV và JD gốc qua lớp.</div>
            <div class="form-check mb-3"><input asp-for="Join.AcceptSharing" class="form-check-input" /><label asp-for="Join.AcceptSharing" class="form-check-label">Tôi đồng ý phạm vi chia sẻ trên.</label></div>
            <button class="btn btn-primary" type="submit">Tham gia lớp</button>
        </form>
    </div></div></section>
</div>
