@model ClassListVm
@{ ViewData["Title"] = "Lớp học của tôi"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Lớp học của tôi</h1><p class="text-muted">Luyện tập theo bài giao và nhận góp ý từ giảng viên.</p></div></div>
<div class="row g-4">
    <div class="col-lg-5"><div class="card"><div class="card-body">
        <h2 class="h4">Tham gia lớp</h2>
        <form asp-action="Join" method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="mb-3"><label asp-for="Join.Code" class="form-label"></label><input asp-for="Join.Code" class="form-control text-uppercase" placeholder="Mã từ giảng viên" autocomplete="off" /></div>
            <div class="alert alert-info">Khi tham gia, giảng viên quản lý lớp có thể xem toàn bộ lịch sử luyện tập, transcript, điểm và tiến bộ của bạn, kể cả các buổi trước khi vào lớp. CV và JD gốc không được cấp quyền tải qua lớp.</div>
            <div class="form-check mb-3"><input asp-for="Join.AcceptSharing" class="form-check-input" /><label asp-for="Join.AcceptSharing" class="form-check-label">Tôi đồng ý phạm vi chia sẻ trên.</label></div>
            <button class="btn btn-primary" type="submit">Tham gia lớp</button>
        </form>
    </div></div></div>
    <div class="col-lg-7">
        @if (Model.Classes.Count == 0) { <div class="card"><div class="card-body">Bạn chưa tham gia lớp nào. Nhập mã lớp do giảng viên cung cấp.</div></div> }
        @foreach (var classroom in Model.Classes)
        {
            <div class="card mb-3"><div class="card-body d-flex justify-content-between align-items-center gap-3">
                <div><h2 class="h5 mb-1">@classroom.Name</h2><span class="badge @(classroom.IsActive ? "bg-success" : "bg-secondary")">@(classroom.IsActive ? "Đang mở" : "Đã đóng")</span></div>
                <a asp-action="Details" asp-route-id="@classroom.Id" class="btn btn-outline-primary">Xem bài tập</a>
            </div></div>
        }
    </div>
</div>
