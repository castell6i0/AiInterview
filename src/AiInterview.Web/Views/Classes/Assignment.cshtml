@model AssignmentDetailVm
@{ ViewData["Title"] = Model.Assignment.Title; }
<a asp-action="Details" asp-route-id="@Model.Assignment.ClassId" class="btn btn-secondary btn-back"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-back" /></svg>@Model.Assignment.Class.Name</a>
<div class="page-heading"><div><h1>@Model.Assignment.Title</h1><p>@Model.Assignment.Position.Name · @ClassroomUi.Label(Model.Assignment.Level) · @ClassroomUi.Label(Model.Assignment.Language) · @ClassroomUi.Label(Model.Assignment.Kind) · @Model.Assignment.QuestionCount câu chính</p></div>@if (Model.Assignment.Class.IsActive) { <a href="/Interviews/Create?assignmentId=@Model.Assignment.Id" class="btn btn-primary">Bắt đầu luyện cho bài này</a> }</div>
@if (TempData["ClassMessage"] is string message) { <div class="alert alert-success" role="status">@message</div> }
@if (TempData["ClassError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<div class="card mb-4"><div class="card-body">
    <p class="preserve">@Model.Assignment.Instructions</p>
    <p class="mb-0"><strong>Hạn nộp:</strong> @ClassroomUi.Date(Model.Assignment.DueAt) (UTC+7) · Rubric #@Model.Assignment.RubricVersionId</p>
    @if (!Model.Assignment.Class.IsActive) { <p class="text-muted mt-2 mb-0">Lớp đã đóng, không tiếp nhận bài nộp mới.</p> }
</div></div>
<h2 class="h4">Nộp buổi đã hoàn thành</h2>
<p class="text-muted small">Chỉ nộp được buổi tạo sau khi giao bài, đúng cấu hình và rubric, trả lời đủ mọi câu chính (không kết thúc sớm hay bỏ qua câu). Mỗi buổi nộp một lần; luyện lại để nộp lần sau.</p>
@if (Model.EligibleSessions.Count == 0) { <p class="text-muted">Chưa có buổi đủ điều kiện. Dùng nút “Bắt đầu luyện cho bài này” để có đúng cấu hình.</p> }
else if (Model.Assignment.Class.IsActive)
{
    <form asp-action="Submit" method="post" class="row g-2 mb-4">
        <input type="hidden" name="assignmentId" value="@Model.Assignment.Id" />
        <div class="col-md-9"><label for="sessionId" class="form-label">Buổi phỏng vấn</label><select name="sessionId" id="sessionId" class="form-select" required>
            @foreach (var session in Model.EligibleSessions) { <option value="@session.Id">@ClassroomUi.Date(session.CreatedAt) · @session.Evaluation?.OverallScore.ToString("0.0")/10</option> }
        </select></div>
        <div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary" type="submit">Nộp bài</button></div>
    </form>
}
<h2 class="h4 mt-5">Lịch sử nộp bài</h2>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Lần</th><th>Thời gian (UTC+7)</th><th>Trạng thái</th><th>Điểm</th><th></th></tr></thead><tbody>
@foreach (var submission in Model.Submissions)
{
    <tr><td>@submission.AttemptNumber</td><td>@ClassroomUi.Date(submission.SubmittedAt)</td><td><span class="pill @(submission.IsLate ? "pill-warn" : "pill-ok")">@(submission.IsLate ? "Nộp muộn" : "Đúng hạn")</span></td><td><span class="score-value score-@Ui.Score(submission.Session.Evaluation?.OverallScore).Band">@(submission.Session.Evaluation?.OverallScore.ToString("0.0") ?? "—")/10</span> <span class="small text-muted">@(submission.Session.Evaluation is null ? "" : Ui.Score(submission.Session.Evaluation.OverallScore).Label)</span></td><td><a href="/Interviews/Report/@submission.SessionId" class="btn btn-secondary btn-sm">Xem báo cáo</a></td></tr>
}
@if (Model.Submissions.Count == 0) { <tr><td colspan="5">Chưa có bài nộp.</td></tr> }
</tbody></table></div>
