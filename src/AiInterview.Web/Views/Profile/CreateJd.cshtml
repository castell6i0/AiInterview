@model CreateJdModel
@{ ViewData["Title"] = "Thêm tin tuyển dụng"; }
<a asp-action="Index" class="mb-3 btn btn-soft btn-sm">← Hồ sơ & mục tiêu</a>
<h1>Thêm tin tuyển dụng</h1><p class="text-muted">Dán JD thật để luyện vào yêu cầu của công việc bạn quan tâm.</p>
<div class="card"><div class="card-body p-4"><form asp-action="CreateJd" method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="row g-3"><div class="col-md-7"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" maxlength="200" required /></div><div class="col-md-5"><label asp-for="Company" class="form-label"></label><input asp-for="Company" class="form-control" maxlength="160" /></div></div>
    <div class="my-3"><label asp-for="SourceUrl" class="form-label"></label><input asp-for="SourceUrl" class="form-control" type="url" placeholder="https://..." maxlength="2048" /><p class="form-text">Link chỉ dùng làm nguồn tham khảo. Hãy dán nội dung vào ô bên dưới.</p></div>
    <div class="mb-3"><label asp-for="Content" class="form-label"></label><textarea asp-for="Content" class="form-control" rows="14" minlength="30" maxlength="30000" required></textarea><p class="form-text">30–30.000 ký tự; nên có trách nhiệm công việc, yêu cầu kỹ năng và cấp độ.</p></div>
    <div class="support-actions"><button type="submit" class="btn btn-primary">Lưu JD</button><a asp-action="Index" class="btn btn-soft btn-sm">Quay lại</a></div>
</form></div></div>
