@model JdDetailModel
@{ ViewData["Title"] = "JD & khoảng trống kỹ năng"; }
<a asp-action="Index" class="btn btn-secondary btn-back"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-back" /></svg>Hồ sơ & mục tiêu</a>
<div class="page-heading"><div><h1>@Model.Jd.Title</h1><p>@Model.Jd.Company · @Ui.Time(Model.Jd.CreatedAt) (UTC+7)</p></div><a asp-controller="Interviews" asp-action="Create" asp-route-jobDescriptionId="@Model.Jd.Id" asp-route-cvProfileId="@Model.Jd.ComparedCvId" asp-route-kind="JobDescription" class="btn btn-primary">Luyện bám JD này</a></div>
@await Html.PartialAsync("_Messages")
@if (TempData["ProfileAiSettingsNeeded"] is true) { <p class="mb-4"><a asp-controller="AiSettings" asp-action="Index" asp-route-returnUrl="@Url.Action("Jd", "Profile", new { id = Model.Jd.Id })" class="btn btn-secondary">Sửa kết nối AI rồi quay lại JD này →</a></p> }
<div class="row g-4">
    <section class="col-lg-5"><div class="card"><div class="card-body p-4">
        <h2 class="h4">CV đáp ứng những gì?</h2>
        <p>Đối chiếu yêu cầu trong JD với bằng chứng trong một phiên bản CV. Thiếu bằng chứng không đồng nghĩa bạn thiếu kỹ năng.</p>
        @if (Model.Gap is not null) {
            <p class="small text-muted">Đã so sánh với CV: @(Model.Cvs.FirstOrDefault(x => x.Id == Model.Jd.ComparedCvId)?.FileName ?? "Phiên bản đã lưu")</p>
            <h3 class="h6 text-success">Có bằng chứng phù hợp</h3><ul>@foreach (var item in Model.Gap.MatchedSkills) { <li class="mb-2">@item</li> }</ul>
            <h3 class="h6">Cần bổ sung bằng chứng</h3><ul>@foreach (var item in Model.Gap.MissingEvidence) { <li class="mb-2">@item</li> }</ul>
            <h3 class="h6">Hướng luyện tập</h3><ol>@foreach (var item in Model.Gap.Recommendations) { <li class="mb-2">@item</li> }</ol>
        }
        @if (Model.Cvs.Count == 0) { <a asp-action="Index" class="btn btn-secondary">Tải CV trước khi so sánh</a> }
        else {
            <form asp-action="CompareGap" method="post" class="mt-4">
                <input type="hidden" name="ConsentedProvider" value="@ActiveAi.Provider" />
                <input type="hidden" name="JdId" value="@Model.Jd.Id" /><label for="CvId" class="form-label">CV dùng để so sánh</label>
                <select name="CvId" id="CvId" class="form-select mb-3" required><option value="">Chọn CV</option>@foreach (var cv in Model.Cvs) { <option value="@cv.Id" selected="@(cv.Id == Model.Jd.ComparedCvId)">@cv.FileName · #@cv.Id</option> }</select>
                <div class="form-check mb-3"><input type="checkbox" name="Consent" value="true" id="gapConsent" class="form-check-input" required /><label for="gapConsent" class="form-check-label">Tôi đồng ý gửi CV đã chọn và JD này tới @ActiveAi.Provider để so sánh.</label></div>
                <button class="btn btn-primary" type="submit" disabled="@(!Model.AiConfigured)">@(Model.Gap is null ? "Tìm khoảng trống kỹ năng" : "So sánh lại")</button>
            </form>
            @if (!Model.AiConfigured) { <div class="mt-3"><p class="text-warning">@ActiveAi.Provider chưa được kết nối; CV/JD vẫn được giữ.</p><div class="support-actions"><a asp-controller="AiSettings" asp-action="Index" asp-route-returnUrl="@Url.Action("Jd", "Profile", new { id = Model.Jd.Id })" class="btn btn-secondary btn-sm">Mở Cài đặt AI để nhập key →</a></div></div> }
        }
    </div></div></section>
    <section class="col-lg-7"><div class="card"><div class="card-body p-4"><h2 class="h4">Nội dung tuyển dụng</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Jd.SourceUrl)) { <a href="@Model.Jd.SourceUrl" target="_blank" rel="noopener noreferrer" class="mb-3 btn btn-secondary btn-sm">Mở tin gốc <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-external" /></svg></a> }
        <div style="white-space:pre-wrap;overflow-wrap:anywhere">@Model.Jd.Content</div>
    </div></div></section>
</div>
<div class="mt-4">@if (Model.CanDelete) { <form asp-action="DeleteJd" asp-route-id="@Model.Jd.Id" method="post"><button class="btn btn-danger btn-sm" type="submit"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-trash" /></svg>Xóa JD chưa sử dụng</button></form> } else { <p class="small text-muted">JD đã dùng trong lịch sử và được giữ nguyên phiên bản. Tạo JD mới nếu nội dung tuyển dụng thay đổi.</p> }</div>
