@using System.Text.Json
@using AiInterview.Web.Services
@model AiSettingsViewModel
@{
    ViewData["Title"] = "Cài đặt AI";
    var selectedIsOpenAi = Model.Provider == "OpenAI";
    var selectedHasKey = selectedIsOpenAi ? Model.HasOpenAiKey : Model.HasGeminiKey;
    var selectedKeyUnavailable = selectedIsOpenAi ? Model.OpenAiKeyUnavailable : Model.GeminiKeyUnavailable;
}
<div class="page-heading">
    <div><h1>Kết nối AI</h1><p>Chọn dịch vụ, dán API key, lưu rồi kiểm tra kết nối.</p></div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="ai-panel" id="aiSettings"
     data-gemini-model="@Model.GeminiModel" data-open-ai-model="@Model.OpenAiModel"
     data-has-gemini-key="@Model.HasGeminiKey.ToString().ToLowerInvariant()" data-has-open-ai-key="@Model.HasOpenAiKey.ToString().ToLowerInvariant()"
     data-gemini-key-unavailable="@Model.GeminiKeyUnavailable.ToString().ToLowerInvariant()" data-open-ai-key-unavailable="@Model.OpenAiKeyUnavailable.ToString().ToLowerInvariant()">

    @* Trạng thái hiện tại + việc nên làm tiếp. *@
    <section class="ai-panel-head" aria-labelledby="currentAiHeading">
        <div class="ai-current-copy">
            <span class="eyebrow">ĐANG SỬ DỤNG</span>
            <h2 id="currentAiHeading">@Model.EffectiveProvider <span class="ai-source-label">@(Model.UsePersonalSettings ? "Key cá nhân" : "Cấu hình hệ thống")</span></h2>
            <p class="ai-current-model">Model <strong>@Model.EffectiveModel</strong> · @(Model.IsConfigured ? "đã lưu cấu hình" : "chưa có key dùng được")</p>
        </div>
        <div class="ai-panel-actions">
            <form asp-controller="AiSettings" asp-action="TestConnection" method="post" data-preserve-on-limit data-rate-group="ai-settings" id="aiConnectionCheckForm" aria-describedby="connectionCheckHelp">
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="btn btn-ai" disabled="@(!Model.IsConfigured)">Kiểm tra kết nối đã lưu</button>
            </form>
            @if (Model.IsConfigured) { <a href="@Model.ContinueUrl" class="btn btn-primary">@(Model.ReturnUrl is not null ? "Quay lại việc đang làm" : User.IsInRole(Roles.Student) ? "Tiếp tục luyện phỏng vấn" : "Về trang chính") <span class="btn-arrow" aria-hidden="true">→</span></a> }
            else if (Model.ReturnUrl is not null) { <a href="@Model.ReturnUrl" class="btn btn-secondary">Quay lại trang trước</a> }
        </div>
        <p class="help-text ai-panel-note" id="connectionCheckHelp">Kiểm tra tạo một nội dung mẫu ngắn bằng cấu hình đã lưu, có thể dùng một ít hạn mức; không gửi CV hay câu trả lời.</p>
    </section>

    @* Kết nối cá nhân: nhà cung cấp → key → model → lưu. *@
    <form asp-controller="AiSettings" asp-action="Save" method="post" data-preserve-on-limit data-rate-group="ai-settings" id="aiSettingsForm" autocomplete="off" aria-labelledby="personalAiHeading">
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <h2 id="personalAiHeading" class="visually-hidden">Kết nối cá nhân</h2>
        <div asp-validation-summary="All" role="alert" class="ai-row-alert"></div>

        <div class="ai-row">
            <div class="ai-row-label"><span class="ai-row-index">01</span><h3><label asp-for="Provider">Nhà cung cấp</label></h3><p>Gemini có hạn mức miễn phí. Kết nối đã lưu không tự thay đổi.</p></div>
            <div class="ai-row-control">
                <select asp-for="Provider" class="form-select" aria-describedby="providerHelp">
                    <option value="Gemini">Google Gemini · Có hạn mức miễn phí</option>
                    @if (selectedIsOpenAi)
                    {
                        <option value="OpenAI">OpenAI · Kết nối cũ có phí</option>
                    }
                </select>
                <p class="help-text" id="providerHelp">Danh sách chọn nhanh chỉ gồm model Gemini có hạn mức miễn phí.</p>
                @if (!selectedIsOpenAi && (Model.HasOpenAiKey || Model.OpenAiKeyUnavailable))
                {
                    <details class="mt-2"><summary>Nâng cao · Kết nối cũ có phí</summary><p class="help-text">OpenAI đã lưu vẫn được giữ để quản lý, không nằm trong danh sách miễn phí.</p><a asp-action="Index" asp-route-provider="OpenAI" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-secondary btn-sm">Quản lý OpenAI đã lưu</a></details>
                }
            </div>
        </div>

        <div class="ai-row">
            <div class="ai-row-label"><span class="ai-row-index">02</span><h3><label for="ApiKey">API key <span id="keyProviderName">@Model.Provider</span></label></h3><p>Được mã hóa và không hiển thị lại. Đừng chia sẻ key cho người khác.</p></div>
            <div class="ai-row-control">
                <div class="ai-field-heading"><a class="ai-key-link" href="https://aistudio.google.com/apikey" target="_blank" rel="noopener noreferrer">Lấy key Gemini tại Google AI Studio <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-external" /></svg></a><span class="ai-key-state" id="selectedKeyState">@(selectedKeyUnavailable ? "Cần nhập lại key" : selectedHasKey ? "Đã lưu key" : "Chưa có key cá nhân")</span></div>
                <div class="ai-key-input">
                    <input type="password" id="ApiKey" name="ApiKey" value="" class="form-control" autocomplete="new-password" spellcheck="false" autocapitalize="off" maxlength="2048" placeholder="Dán API key của bạn tại đây" aria-describedby="keyHelp providerChangeNotice" />
                    <button class="btn btn-secondary" type="button" id="toggleApiKey" aria-controls="ApiKey" aria-pressed="false" hidden>Hiện key</button>
                </div>
                <p class="help-text" id="keyHelp">Đã lưu key thì có thể để trống ô này.</p>
                <p class="help-text ai-inline-notice" id="providerChangeNotice" role="status" aria-live="polite"></p>
                @if (selectedIsOpenAi)
                {
                    <a class="ai-key-link" href="https://platform.openai.com/settings/organization/api-keys" target="_blank" rel="noopener noreferrer">Quản lý key OpenAI (kết nối cũ có phí) <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-external" /></svg></a>
                }
            </div>
        </div>

        <section class="ai-row" aria-labelledby="modelPickerHeading">
            <div class="ai-row-label"><span class="ai-row-index">03</span><h3 id="modelPickerHeading">Model để luyện tập</h3><p>Danh sách tham khảo: @AiModelCatalog.CheckedOn</p></div>
            <div class="ai-row-control">
                <div class="ai-field-heading"><span class="ai-source-label" id="modelTierLabel">@(selectedIsOpenAi ? "Cần số dư API" : "Có lựa chọn miễn phí")</span><a id="modelPricingLink" href="@(selectedIsOpenAi ? "https://developers.openai.com/api/docs/pricing" : "https://ai.google.dev/gemini-api/docs/pricing")" class="ai-key-link" target="_blank" rel="noopener noreferrer">Xem phí &amp; hạn mức <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-external" /></svg></a></div>
                <p class="help-text" id="modelProviderNote">@(selectedIsOpenAi ? "Đây là kết nối OpenAI cũ có phí; không có model gợi ý miễn phí. Chọn Google Gemini và nhập key Gemini để xem các lựa chọn có hạn mức miễn phí." : "Chỉ gồm model có hạn mức miễn phí cho tài khoản đủ điều kiện. Dự án Google AI Studio đã bật thanh toán vẫn có thể tính phí.")</p>
                <div class="row g-3">
                    <div class="col-md" id="modelQuickPick" hidden>
                        <label for="ModelPreset" class="form-label">Chọn nhanh</label>
                        <select id="ModelPreset" class="form-select" aria-describedby="modelSelectionNote modelProviderNote"></select>
                    </div>
                    <div class="col-md">
                        <label asp-for="Model" class="form-label">Tên model · có thể tự nhập</label>
                        <input asp-for="Model" class="form-control" maxlength="100" autocomplete="off" spellcheck="false" autocapitalize="off" required aria-describedby="modelHelp modelSelectionNote" />
                    </div>
                </div>
                <p class="help-text" id="modelHelp">Model ngoài danh sách không được xác nhận có hạn mức miễn phí.</p>
                <p class="ai-model-selection" id="modelSelectionNote" role="status" aria-live="polite">Bấm Lưu &amp; kiểm tra model để xác nhận bằng key của bạn.</p>
            </div>
        </section>

        <div class="ai-row ai-row-save">
            <div class="ai-row-label"></div>
            <div class="ai-row-control">
                <div class="ai-save-row"><button type="submit" name="CheckConnection" value="true" class="btn btn-primary" id="saveAndCheckModel">Lưu &amp; kiểm tra model <span class="btn-arrow" aria-hidden="true">→</span></button><button type="submit" class="btn btn-secondary">Chỉ lưu</button></div>
                <p class="help-text mt-2 mb-0">Kiểm tra gửi một mẫu ngắn, không gửi CV hay câu trả lời; có thể dùng hạn mức hoặc số dư API của bạn.</p>
            </div>
        </div>
    </form>

    @* Quản lý: key đã lưu và cấu hình hệ thống. *@
    <section class="ai-row" aria-labelledby="savedKeysHeading">
        <div class="ai-row-label"><span class="ai-row-index">04</span><h3 id="savedKeysHeading">Key đã lưu</h3><p>Xóa key sẽ ngừng kết nối tương ứng; lịch sử luyện tập được giữ.</p></div>
        <div class="ai-row-control">
            <div class="ai-saved-key-row">
                <div><strong>Google Gemini</strong><span>@(Model.GeminiKeyUnavailable ? "Không đọc được key đã lưu · cần nhập lại" : Model.HasGeminiKey ? "Đã lưu key cá nhân" : "Chưa lưu key cá nhân")</span></div>
                @if (Model.HasGeminiKey || Model.GeminiKeyUnavailable)
                {
                    <form asp-controller="AiSettings" asp-action="DeleteKey" method="post" data-preserve-on-limit data-rate-group="ai-settings"><input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" /><input type="hidden" name="Provider" value="Gemini" /><button type="submit" class="btn btn-sm btn-danger" aria-label="Xóa key cá nhân Gemini"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-trash" /></svg>Xóa key</button></form>
                }
            </div>
            @if (Model.HasOpenAiKey || Model.OpenAiKeyUnavailable || selectedIsOpenAi)
            {
            <div class="ai-saved-key-row">
                <div><strong>OpenAI</strong><span>@(Model.OpenAiKeyUnavailable ? "Không đọc được key đã lưu · cần nhập lại" : Model.HasOpenAiKey ? "Đã lưu key cá nhân" : "Chưa lưu key cá nhân")</span></div>
                @if (Model.HasOpenAiKey || Model.OpenAiKeyUnavailable)
                {
                    <form asp-controller="AiSettings" asp-action="DeleteKey" method="post" data-preserve-on-limit data-rate-group="ai-settings"><input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" /><input type="hidden" name="Provider" value="OpenAI" /><button type="submit" class="btn btn-sm btn-danger" aria-label="Xóa key cá nhân OpenAI"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-trash" /></svg>Xóa key</button></form>
                }
            </div>
            }
        </div>
    </section>

    <section class="ai-row" aria-labelledby="serverAiHeading">
        <div class="ai-row-label"><span class="ai-row-index">05</span><h3 id="serverAiHeading">Cấu hình hệ thống</h3><p>@(Model.ServerIsConfigured ? "Kết nối do quản trị viên thiết lập. Key cá nhân vẫn được giữ để chuyển lại sau." : "Quản trị viên chưa thiết lập kết nối hệ thống; hãy dùng key cá nhân.")</p></div>
        <div class="ai-row-control">
            <form asp-controller="AiSettings" asp-action="UseServerDefaults" method="post" data-preserve-on-limit data-rate-group="ai-settings"><input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" /><button type="submit" class="btn btn-secondary" disabled="@(!Model.ServerIsConfigured || !Model.UsePersonalSettings)">@(Model.UsePersonalSettings ? "Chuyển sang cấu hình hệ thống" : "Đang dùng cấu hình hệ thống")</button></form>
        </div>
    </section>

    <div class="ai-panel-foot"><a href="/Home/Help#connectionHelp" class="page-back">Xem hướng dẫn kết nối từng bước →</a></div>
</div>
@section Scripts {
    <script id="aiModelCatalog" type="application/json">@Html.Raw(JsonSerializer.Serialize(AiModelCatalog.Models, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
    <script src="~/js/ai-settings.js" asp-append-version="true"></script>
}
