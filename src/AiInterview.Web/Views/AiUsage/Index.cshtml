@model AiInterview.Web.Controllers.AiUsagePage
@{ ViewData["Title"] = "Sử dụng AI theo ngày"; }
<h1>Sử dụng AI theo ngày</h1>
<p class="text-muted">Theo dõi lượt gọi, token và chi phí ước tính của từng tài khoản.</p>
<a asp-controller="Admin" asp-action="Index" class="btn btn-soft mb-3">← Quay lại quản trị</a>
<div class="card mb-3"><div class="card-body">
    <p><strong>AI hệ thống:</strong> @(Model.SystemKeyEnabled ? "Đang bật" : "Đang tắt") · @Model.DailyQuota lượt/ngày/tài khoản · @(Model.MonthlyQuota > 0 ? $"{Model.MonthlyQuota} lượt/tháng/tài khoản" : "Không đặt hạn mức tháng")</p>
    <form method="get" class="d-flex flex-wrap align-items-end gap-2">
        <div><label for="usage-day" class="form-label">Ngày tính quota (UTC)</label><input id="usage-day" name="day" type="date" value="@Model.Day.ToString("yyyy-MM-dd")" class="form-control" required /></div>
        <button class="btn btn-primary" type="submit">Xem thống kê</button>
    </form>
    <p class="small text-muted mt-3 mb-0">Một ngày UTC bắt đầu lúc 07:00 và kết thúc trước 07:00 hôm sau theo giờ Việt Nam (UTC+7). Lượt retry và kiểm tra kết nối cũng được tính. Lượt hủy trước khi gửi không tính quota.</p>
</div></div>
<div class="card"><div class="card-body">
    <div class="table-responsive"><table class="table align-middle">
        <thead><tr><th>Mã tài khoản</th><th>Dịch vụ</th><th>Loại key</th><th>Lượt</th><th>Token vào</th><th>Token ra</th><th>Chi phí đã biết (USD)</th><th>Chưa rõ chi phí</th></tr></thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr><td class="text-break">@row.UserId</td><td>@row.Provider</td><td>@(row.KeySource == "System" ? "Hệ thống" : row.KeySource == "Personal" ? "Cá nhân" : "Dữ liệu cũ")</td><td>@row.Requests</td><td>@row.InputTokens.ToString("N0")</td><td>@row.OutputTokens.ToString("N0")</td><td>@row.KnownCostUsd.ToString("0.000000")</td><td>@row.UnknownCostCount</td></tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="8">Chưa có lượt gọi trong ngày này.</td></tr> }
        </tbody>
    </table></div>
    <p class="small text-muted">Chi phí chỉ cộng các giá trị đã biết, không phải hóa đơn. Token thiếu hoặc nhà cung cấp chưa trả usage không được tự ước lượng. Các bản ghi trước khi nâng cấp được ghi là “Dữ liệu cũ”.</p>
    <div class="d-flex gap-2">
        @if (Model.Page > 1) { <a asp-route-day="@Model.Day.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Page - 1)" class="btn btn-soft">← Trang trước</a> }
        @if (Model.HasMore) { <a asp-route-day="@Model.Day.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Page + 1)" class="btn btn-soft">Trang tiếp →</a> }
    </div>
</div></div>
