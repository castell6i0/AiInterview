@model InterviewSession
@{ViewData["Title"]="Xem lại buổi luyện";ViewData["Heading"]=$"Timeline · {Model.Position.Name}";}
<div class="page-heading"><div><span class="eyebrow">TIMELINE</span><h1>@Model.Position.Name</h1><p>@Ui.Time(Model.StartedAt??Model.CreatedAt) · @Ui.Label(Model.Language)</p></div><a asp-action="Report" asp-route-id="@Model.Id" class="btn btn-secondary">Về báo cáo</a></div>
@if(Model.Turns.Count==0){<p>Buổi này chưa có câu hỏi.</p>}
@foreach(var t in Model.Turns.OrderBy(x=>x.SequenceNumber)){<section class="timeline-item"><div class="card"><div class="card-body"><div class="d-flex justify-content-between flex-wrap gap-2"><span class="eyebrow">LƯỢT @t.SequenceNumber · CÂU @t.MainQuestionNumber @(t.FollowUpDepth>0?$"· HỎI THÊM {t.FollowUpDepth}":"")</span><span class="small text-muted">@Ui.Time(t.CreatedAt)</span></div><h2 class="h5 mt-3 preserve">@t.Question</h2><div class="answer-compare mt-3">@(t.Status==TurnStatus.Skipped?"Đã bỏ qua":t.Answer??t.DraftAnswer??"Chưa trả lời")</div><div class="small text-muted mt-2">Gửi lúc @Ui.Time(t.SubmittedAt) · Điểm <span class="score-value score-@Ui.Score(t.Evaluation?.OverallScore).Band">@(t.Evaluation?.OverallScore.ToString("0.0")??"—")/10</span>@(t.Evaluation is null?"":" · "+Ui.Score(t.Evaluation.OverallScore).Label)</div><form asp-action="Mark" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap align-items-center gap-3 mt-3"><input type="hidden" name="TurnId" value="@t.Id"/><label class="form-check mb-0"><input type="checkbox" class="form-check-input" name="Starred" value="true" checked="@t.Starred"/><span class="form-check-label small">Câu trả lời hay</span></label><label class="form-check mb-0"><input type="checkbox" class="form-check-input" name="NeedsPractice" value="true" checked="@t.NeedsPractice"/><span class="form-check-label small">Cần luyện thêm</span></label><button class="btn btn-sm btn-primary" type="submit">Lưu đánh dấu</button></form></div></div></section>}
