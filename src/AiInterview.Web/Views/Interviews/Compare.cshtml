@model CompareModel
@{ViewData["Title"]="So sánh hai buổi";var same=Model.Left.PositionId==Model.Right.PositionId&&Model.Left.Level==Model.Right.Level&&Model.Left.Language==Model.Right.Language&&Model.Left.RubricVersionId==Model.Right.RubricVersionId;}
<div class="page-heading"><div><span class="eyebrow">NHÌN THẤY SỰ THAY ĐỔI</span><h1>Hai buổi, một hành trình</h1><p>Đối chiếu điểm, chủ đề và cách trả lời để chọn điều cần luyện tiếp.</p></div><a href="/Dashboard/History" class="btn btn-outline-primary">Chọn buổi khác</a></div>
@if(!same||Model.Left.Evaluation?.IsProvisional==true||Model.Right.Evaluation?.IsProvisional==true){<div class="alert alert-warning">Hai buổi khác vị trí/cấp độ/ngôn ngữ/rubric hoặc có báo cáo chưa đầy đủ. Các điểm chỉ đặt cạnh nhau để tham khảo, không thể kết luận trực tiếp bạn tiến bộ hay giảm sút.</div>}
<div class="row g-4">@foreach(var s in new[]{Model.Left,Model.Right}){<div class="col-md-6 compare-col"><div class="card h-100"><div class="card-body"><span class="small text-muted">@Ui.Time(s.CreatedAt)</span><h2 class="h4 mt-2">@s.Position.Name</h2><p class="small">@Ui.Label(s.Level) · @Ui.Label(s.Language) · @Ui.Label(s.Kind)</p><div class="metric-number">@(s.Evaluation?.OverallScore.ToString("0.0")??"—")<small class="fs-6 text-muted"> /10</small></div><p class="mt-2"><strong>@s.Evaluation?.Verdict</strong> · Hoàn thành @(s.Evaluation?.CompletionRate.ToString("0.#")??"—")%</p><p class="small">@s.Evaluation?.Reason</p><p class="small text-muted">Rubric: @s.RubricVersion.Name</p><a asp-action="Report" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary mb-4">Báo cáo chi tiết →</a>@foreach(var t in s.Turns.OrderBy(t=>t.SequenceNumber)){<div class="border-top py-3"><strong class="small">Câu @t.MainQuestionNumber @(t.FollowUpDepth>0?"· Hỏi thêm":"") · @(t.Evaluation?.OverallScore.ToString("0.0")??"—")/10</strong><p class="small preserve mt-1">@t.Question</p><details><summary class="small">Câu trả lời</summary><div class="answer-compare small mt-2">@(t.Answer??"Chưa trả lời")</div></details></div>}</div></div></div>}</div>
