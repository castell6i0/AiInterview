@model CreateInterviewModel
@{ ViewData["Title"] = "Tạo buổi luyện"; }
<div class="page-heading">
    <div><span class="eyebrow">LUYỆN PHỎNG VẤN</span><h1>Chuẩn bị buổi luyện của bạn</h1><p>Chọn vị trí và cách trả lời. Bạn có thể bắt đầu ngay với 5 câu hỏi.</p></div>
    <a href="/Dashboard/History" class="btn btn-secondary">Xem các buổi đã luyện</a>
</div>
<ol class="flow-steps" aria-label="Các bước luyện phỏng vấn">
    <li class="current" aria-current="step"><span>1</span> Chọn buổi luyện</li>
    <li><span>2</span> Trả lời câu hỏi</li>
    <li><span>3</span> Nhận góp ý & luyện tiếp</li>
</ol>
@if (!Model.AiConfigured) { <div class="alert alert-warning" role="alert"><p><strong>Cần kết nối @ActiveAi.Provider để bắt đầu.</strong> Hãy kết nối AI trước, rồi quay lại chọn buổi luyện.</p><div class="support-actions"><a asp-controller="AiSettings" asp-action="Index" asp-route-returnUrl="@Url.Action("Create", "Interviews", new { assignmentId = Model.AssignmentId, cvProfileId = Model.CvProfileId, jobDescriptionId = Model.JobDescriptionId, kind = Model.Kind })" class="btn btn-secondary btn-sm">Mở Cài đặt AI để nhập key →</a></div></div> }
@if (Model.AssignmentId.HasValue) { <div class="alert alert-info"><strong>Bài tập: @Model.AssignmentTitle.</strong> Giữ đúng vị trí, cấp độ, ngôn ngữ, loại và số câu giảng viên yêu cầu.</div> }
<form asp-action="Create" method="post" id="createInterviewForm">
    <input type="hidden" name="ConsentedProvider" value="@ActiveAi.Provider" />
    <input asp-for="AssignmentId" type="hidden" />
    <div asp-validation-summary="All" role="alert"></div>
    <div class="setup-layout">
        <div class="setup-main">
            <section class="card setup-section" aria-labelledby="contentHeading"><div class="card-body">
                <div class="section-heading"><span class="step-dot" aria-hidden="true">1</span><h2 id="contentHeading">Bạn muốn luyện cho vị trí nào?</h2></div>
                <p class="section-description">AI điều chỉnh câu hỏi theo vị trí và kinh nghiệm của bạn.</p>
                <div class="row g-3">
                    <div class="col-md-8"><label asp-for="PositionId" class="form-label">Vị trí ứng tuyển <span class="text-danger" aria-hidden="true">*</span></label><select asp-for="PositionId" class="form-select" required><option value="">Chọn vị trí ứng tuyển</option>@foreach (var p in Model.Positions) { <option value="@p.Id">@p.Name</option> }</select></div>
                    <div class="col-md-4"><label asp-for="Level" class="form-label">Cấp độ</label><select asp-for="Level" class="form-select">@foreach (var v in Enum.GetValues<InterviewLevel>()) { <option value="@((int)v)">@Ui.Label(v)</option> }</select></div>
                    <div class="col-md-8"><label asp-for="Kind" class="form-label">Nội dung phỏng vấn</label><select asp-for="Kind" class="form-select" aria-describedby="kindHelp">@foreach (var v in Enum.GetValues<InterviewKind>()) { <option value="@((int)v)">@Ui.Label(v)</option> }</select><p id="kindHelp" class="help-text">Ôn kiến thức chuyên môn qua câu hỏi và tình huống thực tế.</p></div>
                    <div class="col-md-4"><label asp-for="QuestionCount" class="form-label">Số câu chính</label><select asp-for="QuestionCount" class="form-select">@for (var i = 5; i <= 10; i++) { <option value="@i">@i câu</option> }</select><p class="help-text">Mới bắt đầu? Chọn 5 câu.</p></div>
                </div>
            </div></section>
            <section class="card setup-section" aria-labelledby="styleHeading"><div class="card-body">
                <div class="section-heading"><span class="step-dot" aria-hidden="true">2</span><h2 id="styleHeading">Chọn cách bạn muốn trả lời</h2></div>
                <p class="section-description">Dùng văn bản hoặc microphone, bằng tiếng Việt hoặc tiếng Anh.</p>
                <div class="row g-3">
                    <div class="col-md-4"><label asp-for="Language" class="form-label">Ngôn ngữ</label><select asp-for="Language" class="form-select">@foreach (var v in Enum.GetValues<InterviewLanguage>()) { <option value="@((int)v)">@Ui.Label(v)</option> }</select></div>
                    <div class="col-md-4"><label asp-for="Mode" class="form-label">Hình thức trả lời</label><select asp-for="Mode" class="form-select" aria-describedby="modeHelp">@foreach (var v in Enum.GetValues<InterviewMode>()) { <option value="@((int)v)">@Ui.Label(v)</option> }</select></div>
                    <div class="col-md-4"><label asp-for="Persona" class="form-label">Phong cách người hỏi</label><select asp-for="Persona" class="form-select">@foreach (var v in Enum.GetValues<InterviewPersona>()) { <option value="@((int)v)">@Ui.Label(v)</option> }</select></div>
                </div>
                <p id="modeHelp" class="help-text mb-0 mt-3">Bạn gõ câu trả lời và gửi khi đã sẵn sàng.</p>
            </div></section>
            <details class="card optional-section" id="personalization" open="@(Model.CvProfileId.HasValue || Model.JobDescriptionId.HasValue || Model.Kind is InterviewKind.Project or InterviewKind.JobDescription || !string.IsNullOrWhiteSpace(Model.FocusSkills))">
                <summary class="card-body"><strong>Cá nhân hóa câu hỏi</strong><span class="help-text d-block">Thêm CV, tin tuyển dụng hoặc chủ đề muốn ôn · Tùy chọn</span></summary>
                <div class="card-body pt-0">
                    <div class="row g-3">
                        <div class="col-md-6"><label asp-for="CvProfileId" class="form-label">CV của bạn</label><select asp-for="CvProfileId" class="form-select" aria-describedby="personalizationHelp"><option value="">Không dùng CV</option>@foreach (var cv in Model.Cvs) { <option value="@cv.Id">@cv.FileName · @Ui.Time(cv.CreatedAt)</option> }</select></div>
                        <div class="col-md-6"><label asp-for="JobDescriptionId" class="form-label">Tin tuyển dụng (JD)</label><select asp-for="JobDescriptionId" class="form-select" aria-describedby="personalizationHelp"><option value="">Không dùng JD</option>@foreach (var jd in Model.Jds) { <option value="@jd.Id">@jd.Title · @jd.Company</option> }</select></div>
                        <div class="col-12"><label asp-for="FocusSkills" class="form-label">Chủ đề muốn tập trung</label><input asp-for="FocusSkills" class="form-control" maxlength="500" placeholder="Ví dụ: kiểm thử API, SQL, giao tiếp nhóm…" /></div>
                    </div>
                    <p id="personalizationHelp" class="help-text mt-3">Luyện dự án cần chọn CV; luyện theo tin tuyển dụng cần chọn JD.</p>
                    <a href="/Profile" class="btn btn-secondary btn-sm">Quản lý CV và tin tuyển dụng →</a>
                </div>
            </details>
        </div>
        <aside class="setup-summary" aria-labelledby="summaryHeading"><div class="card"><div class="card-body">
            <span class="eyebrow">SẴN SÀNG CHO BƯỚC TIẾP THEO</span><h2 id="summaryHeading" class="h4 mt-2">Buổi luyện của bạn</h2>
            <dl class="setup-summary-list">
                <dt>Vị trí</dt><dd id="summaryPosition">Chưa chọn vị trí</dd>
                <dt>Nội dung</dt><dd id="summaryKind">@Ui.Label(Model.Kind)</dd>
                <dt>Cấu hình</dt><dd id="summaryPreferences">@Ui.Label(Model.Level) · @Ui.Label(Model.Language)</dd>
                <dt>Cách trả lời</dt><dd id="summaryMode">@Ui.Label(Model.Mode)</dd>
                <dt>Số câu chính</dt><dd id="summaryCount">@Model.QuestionCount câu</dd>
            </dl>
            <div class="consent-panel"><label class="form-check mb-0"><input asp-for="ConsentToAi" class="form-check-input" required /><span class="form-check-label">Tôi đồng ý gửi CV/JD đã chọn và câu trả lời tới @ActiveAi.Provider để tạo câu hỏi và chấm điểm.</span></label></div>
            <button class="btn btn-primary w-100 mt-3" type="submit">Vào phòng phỏng vấn →</button>
            <p class="help-text mt-3 mb-0">Vào phòng trước, rồi bấm bắt đầu khi bạn sẵn sàng.</p>
        </div></div>
        <div class="room-tip mt-3"><h3>Sau buổi luyện, bạn nhận được</h3><ul class="mb-0 ps-3"><li>Điểm theo 5 tiêu chí rõ ràng.</li><li>Góp ý kèm dẫn chứng từ câu trả lời.</li><li>Gợi ý trả lời tốt hơn và kế hoạch ôn tập.</li></ul></div></aside>
    </div>
</form>
@section Scripts { <script src="~/js/interview-setup.js" asp-append-version="true"></script> }
