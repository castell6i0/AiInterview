@using System.Text.Json
@model RoomModel
@{
    ViewData["Title"] = "Phòng phỏng vấn";
    ViewData["Bg"] = "off";
    var s = Model.Session;
    var pending = s.Turns.SingleOrDefault(t => t.Status == TurnStatus.Pending);
    var ready = s.Status == SessionStatus.ReadyForEvaluation;
    var completed = s.Turns.Count(t => t.FollowUpDepth == 0 && t.Status != TurnStatus.Pending);
    var voice = s.Mode == InterviewMode.Voice;
}
<div class="room-shell" id="roomStage" data-state="idle" data-mode="@(voice ? "voice" : "text")">
    <div class="page-heading">
        <div><span class="eyebrow">PHÒNG PHỎNG VẤN</span><h1>@s.Position.Name</h1><div class="d-flex flex-wrap gap-1"><span class="tag">@Ui.Label(s.Level)</span><span class="tag">@Ui.Label(s.Language)</span><span class="tag">@Ui.Label(s.Kind)</span><span class="tag">@Ui.Label(s.Persona)</span></div></div>
        <div class="room-session-tools"><span class="room-meta">Thời gian luyện</span><div id="sessionTimer" class="room-timer">00:00</div><button type="button" id="endButton" class="btn btn-sm btn-danger mt-2" disabled="@ready">Kết thúc sớm</button></div>
    </div>
    @Html.AntiForgeryToken()
    @if (TempData["ProviderError"] is string providerError) { <div class="alert alert-warning" role="alert">@providerError</div> }
    @if (s.AiProvider != ActiveAi.Provider) {
        <div class="alert alert-warning"><strong>Đổi nhà cung cấp AI: @s.AiProvider → @ActiveAi.Provider</strong><p class="mt-2">Câu trả lời đã lưu vẫn được giữ. Để tiếp tục với @ActiveAi.Provider, cần gửi CV/JD và nội dung buổi này tới nhà cung cấp mới.</p><form asp-action="ConsentProvider" asp-route-id="@s.Id" method="post"><input type="hidden" name="provider" value="@ActiveAi.Provider" /><label class="form-check"><input class="form-check-input" type="checkbox" name="consent" value="true" required /><span class="form-check-label">Tôi đồng ý gửi dữ liệu của buổi này tới @ActiveAi.Provider.</span></label><button class="btn btn-primary btn-sm mt-2" type="submit">Tiếp tục với @ActiveAi.Provider</button></form></div>
    }
    @if (!Model.AiConfigured) { <div class="alert alert-warning"><p><strong>Cần kết nối @ActiveAi.Provider để tiếp tục.</strong></p><div class="support-actions"><a asp-controller="AiSettings" asp-action="Index" asp-route-returnUrl="@Url.Action("Room", "Interviews", new { id = s.Id })" class="btn btn-secondary btn-sm">Mở Cài đặt AI để nhập key →</a></div></div> }
    <div id="roomError" class="alert alert-danger support-action-row" role="alert" hidden><span id="roomErrorMessage"></span> <a id="roomAiSettings" asp-controller="AiSettings" asp-action="Index" asp-route-returnUrl="@Url.Action("Room", "Interviews", new { id = s.Id })" hidden class="btn btn-secondary btn-sm">Sửa kết nối AI rồi quay lại buổi này →</a></div>
    <div id="voiceNotice" class="alert alert-info" role="status" hidden></div>
    <div class="room-guidance" aria-live="polite"><span class="step-dot" aria-hidden="true"><svg class="icon" focusable="false"><use href="#i-terminal" /></svg></span><div><strong id="nextActionTitle">Bắt đầu khi bạn sẵn sàng</strong><p id="nextActionText" class="mb-0">Bấm “Bắt đầu phỏng vấn” để nhận câu hỏi đầu tiên. Bạn có thể suy nghĩ trước khi trả lời.</p></div></div>
    <div class="row g-4">
        <div class="col-lg-9">
            <section class="room-question mb-4" aria-label="Câu hỏi phỏng vấn">
                <div class="d-flex justify-content-between gap-3 align-items-start"><div class="d-flex gap-3 align-items-center">@if (!voice) { <span class="ai-avatar" aria-hidden="true">AI</span> }<div><strong>Người phỏng vấn</strong><div class="room-status"><span class="status-dot" id="statusDot"></span><span id="roomStatus" role="status">@(ready ? "Đã hoàn tất phần trả lời" : pending is null ? "Sẵn sàng bắt đầu" : "Đang chờ bạn trả lời")</span></div></div></div><span id="questionCounter" class="question-label">@(pending is null ? "" : $"Câu {pending.MainQuestionNumber}/{s.PlannedQuestionCount}")</span></div>
                @if (voice) { <div class="voice-stage" aria-hidden="true"><span class="ai-avatar ai-avatar-lg">AI</span><div class="wave">@for (var i = 0; i < 24; i++) { <i style="--i:@i"></i> }</div><span class="voice-stage-label"></span></div> }
                <div class="question-text" id="questionText" aria-live="polite">@(pending?.Question ?? (ready ? "Bạn đã hoàn tất phần trả lời. Hãy xem báo cáo để biết điều cần luyện tiếp." : "Buổi luyện đã sẵn sàng. Câu hỏi sẽ xuất hiện ở đây."))</div>
                <div class="question-actions"><button class="btn btn-sm btn-ai" id="readButton" type="button" aria-label="Đọc lại câu hỏi" disabled="@(pending is null)">Đọc câu hỏi</button><label class="form-check mb-0"><input type="checkbox" class="form-check-input" id="autoRead" checked="@voice" />Tự đọc câu mới</label></div>
                <details class="mt-3 border-top pt-3"><summary class="small">Giọng đọc và tốc độ</summary><div class="row g-3 mt-1"><div class="col-sm-8"><label for="ttsVoice" class="form-label">Giọng @(s.Language == InterviewLanguage.English ? "tiếng Anh" : "tiếng Việt")</label><select id="ttsVoice" class="form-select form-select-sm"><option value="">Đang tải giọng đọc…</option></select></div><div class="col-sm-4"><label for="ttsRate" class="form-label">Tốc độ đọc</label><select id="ttsRate" class="form-select form-select-sm"><option value="0.75">0,75× · Rất chậm</option><option value="0.8">0,8×</option><option value="0.85">0,85×</option><option value="0.9">0,9× · Chậm</option><option value="0.95" selected>0,95× · Vừa phải</option><option value="1">1× · Bình thường</option><option value="1.05">1,05×</option><option value="1.1">1,1× · Nhanh</option><option value="1.15">1,15×</option><option value="1.2">1,2×</option><option value="1.25">1,25× · Rất nhanh</option></select></div></div><p id="ttsStatus" class="help-text mt-2 mb-0" role="status">Giọng đọc do trình duyệt và thiết bị cung cấp.</p></details>
            </section>
            <section class="room-answer" id="answerPanel" hidden="@(pending is null)" aria-labelledby="answerHeading">
                <div class="answer-toolbar"><strong id="answerHeading">Câu trả lời của bạn</strong><span id="draftStatus" class="small text-muted" role="status">Tự động lưu bản nháp</span></div>
                <p class="answer-hint" id="answerHelp">Nêu ý chính → giải thích cách làm → đưa một ví dụ. Không cần trả lời hoàn hảo.</p>
                <textarea class="form-control" id="answerInput" aria-label="Câu trả lời" aria-describedby="answerHelp" maxlength="20000" placeholder="Theo mình, ý quan trọng nhất là…">@pending?.DraftAnswer</textarea>
                <div id="codePanel" hidden><div class="p-2 border-bottom small text-muted">Trình soạn thảo code · AI góp ý, không thực thi mã.</div><div id="monacoEditor" style="height:320px"></div></div>
                <div id="interimTranscript" class="interim-transcript" aria-live="polite"></div>
                <div class="room-answer-actions"><div class="d-flex gap-2 align-items-center"><button id="micButton" type="button" class="btn btn-ai mic-button" hidden="@(!voice)">Bắt đầu nói</button><span id="wordCount" class="small text-muted">0 từ</span></div><div class="d-flex gap-2"><button id="skipButton" class="btn btn-warning" type="button">Bỏ qua câu này</button><button id="answerButton" class="btn btn-primary" type="button">Gửi câu trả lời →</button></div></div>
            </section>
            <div class="d-flex flex-wrap gap-3 mt-4"><button type="button" id="nextButton" class="btn btn-primary" hidden="@(pending is not null || ready)">@(s.Turns.Count == 0 ? "Bắt đầu phỏng vấn →" : "Nhận câu tiếp theo →")</button><button type="button" id="evaluateButton" class="btn btn-primary" hidden="@(!ready)">Tạo và xem báo cáo →</button></div>
        </div>
        <aside class="col-lg-3">
            <div class="card room-progress-card mb-3"><div class="card-body"><h2 class="h6 mb-3">Tiến độ buổi luyện</h2><div class="room-progress-count" id="progressCount">@completed / @s.PlannedQuestionCount câu chính</div><div class="progress-segments mt-3" style="--n:@s.PlannedQuestionCount" aria-hidden="true"><div id="progressBar" style="width:@(100 * completed / s.PlannedQuestionCount)%"></div></div><p class="help-text mt-3 mb-0">Câu hỏi phụ giúp làm rõ ý và không tính thêm vào số câu chính.</p></div></div>
            <div class="room-tip"><h3>Trong buổi luyện</h3><ol class="ps-3 mb-0"><li class="mb-2">Đọc hoặc nghe câu hỏi.</li><li class="mb-2">Viết hoặc nói câu trả lời, rồi bấm gửi.</li><li>Hoàn tất các câu và xem góp ý.</li></ol></div>
            <p class="help-text mt-3">Câu trả lời được lưu trước khi AI xử lý. Nếu kết nối lỗi, bạn có thể thử lại ngay trong buổi này.</p>
        </aside>
    </div>
</div>
@section Scripts {
    <script id="roomConfig" type="application/json">@Html.Raw(JsonSerializer.Serialize(new { sessionId = s.Id, planned = s.PlannedQuestionCount, language = s.Language == InterviewLanguage.English ? "en-US" : "vi-VN", voice, ready, completedMainCount = completed, startedAt = s.StartedAt, endedAt = s.EndedAt, pending = pending is null ? null : new { id = pending.Id, question = pending.Question, sequenceNumber = pending.SequenceNumber, mainQuestionNumber = pending.MainQuestionNumber, followUpDepth = pending.FollowUpDepth, isCoding = pending.IsCoding, codeLanguage = pending.CodeLanguage, answer = pending.DraftAnswer ?? "" } }, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
    <script src="~/js/speech.js" asp-append-version="true"></script><script src="~/js/interview-room.js" asp-append-version="true"></script>
}
