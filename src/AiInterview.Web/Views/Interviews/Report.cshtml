@using System.Text.Json
@using System.Security.Claims
@model ReportModel
@{ViewData["Title"]="Báo cáo phỏng vấn";var s=Model.Session;var e=s.Evaluation!;var summary=AiPrompts.Read<SessionSummaryResult>(e.SummaryJson)??new();var owner=s.StudentId==User.FindFirstValue(ClaimTypes.NameIdentifier);var criteria=s.RubricVersion.Criteria.OrderBy(c=>c.Id).ToArray();var averages=criteria.Select(c=>new{c.Name,c.Code,Score=Math.Round(s.Turns.GroupBy(t=>t.MainQuestionNumber).Sum(g=>g.Average(t=>t.Evaluation?.Scores.SingleOrDefault(x=>x.RubricCriterionId==c.Id)?.Score??0))/s.PlannedQuestionCount,2)}).ToArray();var overall=Ui.Score(e.OverallScore);var readiness=Ui.Score(e.ReadinessScore/10m);}
<div class="page-heading"><div><span class="eyebrow">NHÌN LẠI ĐỂ TIẾN BỘ</span><h1>@s.Position.Name</h1><p>@Ui.Time(s.CreatedAt) · @Ui.Label(s.Level) · @Ui.Label(s.Language) · @Ui.Label(s.Kind)</p></div>@if(owner){<div class="d-flex flex-wrap gap-2"><a asp-action="Replay" asp-route-id="@s.Id" class="btn btn-secondary">Xem lại buổi</a><a asp-action="Create" class="btn btn-primary">Luyện buổi mới →</a></div>}</div>
@if(e.IsProvisional){<div class="alert alert-warning"><strong>Báo cáo chưa đầy đủ.</strong> Bạn hoàn thành @e.CompletionRate.ToString("0.#")% số câu chính. Câu bỏ qua/chưa được hỏi tính 0 trong tổng; verdict/readiness chỉ là tạm thời, không so sánh như buổi hoàn chỉnh.</div>}
<div class="report-next-step mb-4"><span class="eyebrow">ĐỌC BÁO CÁO THEO 3 BƯỚC</span><h2 class="h5 mt-2">Xem điểm, chọn một điều cần cải thiện, rồi thử lại.</h2><p class="mb-0">Bắt đầu với góp ý và kế hoạch trong các tab bên dưới. Mở tab Từng câu để đối chiếu câu trả lời của bạn với gợi ý.</p></div>
<div class="report-tabs" id="reportTabs">
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation"><button class="nav-link active" id="tab-overview" data-bs-toggle="tab" data-bs-target="#pane-overview" type="button" role="tab" aria-controls="pane-overview" aria-selected="true">Tổng quan</button></li>
    <li role="presentation"><button class="nav-link" id="tab-answers" data-bs-toggle="tab" data-bs-target="#pane-answers" type="button" role="tab" aria-controls="pane-answers" aria-selected="false">Từng câu</button></li>
    <li role="presentation"><button class="nav-link" id="tab-plan" data-bs-toggle="tab" data-bs-target="#pane-plan" type="button" role="tab" aria-controls="pane-plan" aria-selected="false">Kế hoạch ôn tập</button></li>
    <li role="presentation"><button class="nav-link" id="tab-comments" data-bs-toggle="tab" data-bs-target="#pane-comments" type="button" role="tab" aria-controls="pane-comments" aria-selected="false">Nhận xét giảng viên (@Model.Comments.Count)</button></li>
</ul>
<div class="tab-content">
<div class="tab-pane fade show active" id="pane-overview" role="tabpanel" aria-labelledby="tab-overview" tabindex="0">
<div class="row g-4 mb-4" id="report-score"><div class="col-lg-4"><section class="score-panel h-100"><span class="small-pill">NỘI DUNG CÂU TRẢ LỜI</span><div class="big-score mt-4 score-@overall.Band">@e.OverallScore.ToString("0.0")<small> / 10</small></div><p class="score-label score-@overall.Band mt-1 mb-0">@overall.Label</p><h2 class="h4 mt-3">@e.Verdict</h2><p class="small">Mức sẵn sàng luyện tập cho @s.Position.Name: <strong class="score-@readiness.Band">@e.ReadinessScore/100 · @readiness.Label</strong></p><hr/><p class="small mb-0">@e.Reason</p></section></div><div class="col-lg-8"><div class="card h-100"><div class="card-body"><h2 class="h5">Năm góc nhìn về câu trả lời</h2><div class="row g-3 align-items-center"><div class="col-md-6"><div class="chart-box" style="height:250px"><canvas id="rubricChart" role="img" aria-label="Biểu đồ radar điểm theo năm tiêu chí, thang 0 đến 10"></canvas></div></div><div class="col-md-6">@foreach(var criterion in criteria){var avg=averages.Single(a=>a.Name==criterion.Name);var band=Ui.Score(avg.Score);<div class="criterion-row"><div class="d-flex justify-content-between gap-2"><span class="small">@criterion.Name</span><strong class="score-value score-@band.Band">@avg.Score.ToString("0.0")</strong></div><div class="small text-muted">Trọng số @criterion.Weight.ToString("0.#") · @band.Label</div></div>}</div></div>
<details class="mt-3"><summary>Xem bảng số liệu</summary><div class="table-responsive mt-2"><table class="table table-sm"><thead><tr><th>Tiêu chí</th><th class="num">Điểm TB /10</th><th class="num">Trọng số</th></tr></thead><tbody>@foreach(var criterion in criteria){var avg=averages.Single(a=>a.Name==criterion.Name);<tr><td>@criterion.Name</td><td class="num">@avg.Score.ToString("0.00")</td><td class="num">@criterion.Weight.ToString("0.#")</td></tr>}</tbody></table></div></details>
<p class="small text-muted mt-3 mb-0">Rubric: @s.RubricVersion.Name. Mỗi nhóm câu chính có trọng số như nhau; các lượt trong nhóm được lấy trung bình. Điểm tổng được tính trên số câu chính đã chọn.</p></div></div></div></div>
<div class="row g-4 mb-4"><div class="col-md-6"><div class="card h-100"><div class="card-body"><span class="section-label">ĐIỂM MẠNH</span><h2 class="h5 mt-2">Tiếp tục phát huy</h2>@if(summary.Strengths.Length==0){<p class="text-muted">Chưa đủ bằng chứng để tổng hợp điểm mạnh.</p>}else{<ul class="mb-0">@foreach(var item in summary.Strengths){<li class="mb-2">@item</li>}</ul>}</div></div></div><div class="col-md-6"><div class="card h-100"><div class="card-body"><span class="section-label">ĐIỂM CẦN CẢI THIỆN</span><h2 class="h5 mt-2">Tập trung vào điều tiếp theo</h2><ul class="mb-0">@foreach(var item in summary.Weaknesses){<li class="mb-2">@item</li>}</ul></div></div></div></div>
@if(summary.Evidence.Length>0){<div class="card mb-4"><div class="card-body"><h2 class="h5 mb-3">Dẫn chứng từ chính câu trả lời của bạn</h2>@foreach(var evidence in summary.Evidence){<div class="mb-3"><span class="small text-muted">Lượt @evidence.SequenceNumber</span><blockquote class="quote mt-1 mb-2">“@evidence.Quote”</blockquote><p class="small mb-0">@evidence.Explanation</p></div>}</div></div>}
</div>
<div class="tab-pane fade" id="pane-answers" role="tabpanel" aria-labelledby="tab-answers" tabindex="0">
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h2 class="h4 mb-0" id="report-answers">Chi tiết từng câu trả lời</h2><span class="small text-muted">@s.Turns.Count lượt · @s.PlannedQuestionCount câu chính dự kiến</span></div>
<section class="card mb-4"><div class="card-body"><span class="section-label">CÁCH NÓI</span><h2 class="h5 mt-2">Dữ liệu từ buổi luyện</h2><p class="small text-muted">Tính bằng code từ transcript và sự kiện trình duyệt, tách khỏi điểm nội dung. Tốc độ nói và khoảng dừng là ước tính; từ tiếng Việt được đếm theo khoảng trắng. Từ đệm có thể trùng cách dùng bình thường (ví dụ “like”). Không có dữ liệu được hiển thị bằng “—”.</p><div class="table-responsive"><table class="table"><thead><tr><th>Lượt</th><th class="num">Số từ</th><th class="num">Từ/phút</th><th class="num">Nghĩ trước trả lời</th><th class="num">Từ đệm</th><th class="num">Dừng ≥2 giây</th></tr></thead><tbody>@foreach(var turn in s.Turns.OrderBy(t=>t.SequenceNumber)){var d=turn.DeliveryMetric;<tr><td>@turn.SequenceNumber</td><td class="num">@(d?.WordCount.ToString()??"—")</td><td class="num">@(d?.WordsPerMinute?.ToString("0.#")??"—")</td><td class="num">@(d?.ThinkingSeconds.HasValue==true?$"{d.ThinkingSeconds:0.#} giây":"—")</td><td class="num">@(d?.FillerCount?.ToString()??"—")</td><td class="num">@(d?.LongPauseCount?.ToString()??"—")</td></tr>}</tbody></table></div></div></section>
@foreach(var turn in s.Turns.OrderBy(t=>t.SequenceNumber)){
var evaluation=turn.Evaluation;var code=AiPrompts.Read<CodeReviewResult>(evaluation?.CodeReviewJson);var turnBand=Ui.Score(evaluation?.OverallScore);
<section class="card mb-4"><div class="card-body"><div class="d-flex justify-content-between gap-3 mb-3"><div><span class="eyebrow">CÂU @turn.MainQuestionNumber @(turn.FollowUpDepth>0?$"· HỎI THÊM {turn.FollowUpDepth}":"")</span><h3 class="h5 mt-2 preserve">@turn.Question</h3>@foreach(var tag in turn.SkillTags.Split(',',StringSplitOptions.RemoveEmptyEntries)){<span class="tag">@tag</span>}</div><div class="text-end text-nowrap score-@turnBand.Band"><strong class="score-value fs-4">@(evaluation?.OverallScore.ToString("0.0")??"—")</strong><small class="kpi-unit"> /10</small>@if(evaluation is not null){<div class="score-label">@turnBand.Label</div>}</div></div>
@if(turn.Status==TurnStatus.Skipped){<div class="alert alert-warning">Câu này đã được bỏ qua.</div>}else{<div class="row g-3 mb-3"><div class="col-md-6"><h4 class="section-label">CÂU TRẢ LỜI CỦA BẠN</h4><div class="answer-compare">@turn.Answer</div></div><div class="col-md-6"><h4 class="section-label">GỢI Ý TRẢ LỜI TỐT HƠN</h4><div class="answer-compare improved">@evaluation?.BetterAnswer</div></div></div><p class="small"><strong>Đã sửa gì, vì sao:</strong> @evaluation?.ChangesExplanation</p>}
@if(evaluation is not null){<details class="mt-3"><summary class="fw-semibold">Điểm từng tiêu chí & bằng chứng</summary><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Tiêu chí</th><th class="num">Điểm</th><th>Nhận xét và dẫn chứng</th></tr></thead><tbody>@foreach(var score in evaluation.Scores.OrderBy(x=>x.RubricCriterionId)){<tr><td>@score.Criterion.Name</td><td class="num">@score.Score.ToString("0.#")</td><td>@score.Feedback @if(!string.IsNullOrEmpty(score.Evidence)){<blockquote class="quote mt-2 mb-0">“@score.Evidence”</blockquote>}</td></tr>}</tbody></table></div></details><div class="row g-3 mt-2"><div class="col-md-6"><h4 class="small fw-semibold">Điểm mạnh</h4><ul class="small">@foreach(var item in Ui.Strings(evaluation.StrengthsJson)){<li>@item</li>}</ul></div><div class="col-md-6"><h4 class="small fw-semibold">Cần cải thiện</h4><ul class="small">@foreach(var item in Ui.Strings(evaluation.ImprovementsJson)){<li>@item</li>}</ul></div></div>}
@if(turn.Status==TurnStatus.Answered && turn.IsCoding && code is not null){<div class="alert alert-info mt-3"><h4 class="h6">AI review code · không thực thi</h4><p class="small"><strong>Đúng/sai:</strong> @code.Correctness</p><p class="small"><strong>Độ phức tạp:</strong> @code.Complexity</p><p class="small"><strong>Cách viết:</strong> @code.Style</p><strong class="small">Trường hợp biên</strong><ul class="small mb-0">@foreach(var edge in code.EdgeCases){<li>@edge</li>}</ul></div>}</div></section>}
</div>
<div class="tab-pane fade" id="pane-plan" role="tabpanel" aria-labelledby="tab-plan" tabindex="0">
<section class="soft-panel mb-4" id="report-practice"><span class="eyebrow">BƯỚC NHỎ, TIẾN BỘ ĐỀU</span><h2 class="h4 mt-2">Kế hoạch cho những buổi tới</h2>@if(summary.PracticePlan.Length==0){<p class="text-muted mb-0">Báo cáo này chưa có kế hoạch ôn tập.</p>}else{<ol class="mb-0">@foreach(var item in summary.PracticePlan){<li class="mb-2">@item</li>}</ol>}@if(owner){<a href="/Dashboard#practice" class="btn btn-secondary mt-3">Xem kỹ năng & luyện điểm yếu →</a>}</section>
</div>
<div class="tab-pane fade" id="pane-comments" role="tabpanel" aria-labelledby="tab-comments" tabindex="0">
<section class="card mb-4" id="report-comments"><div class="card-body"><h2 class="h5">Nhận xét từ giảng viên</h2>@if(Model.Comments.Count==0){<p class="text-muted mb-0">Chưa có nhận xét cho buổi này. Nhận xét xuất hiện ở đây khi giảng viên của lớp bạn tham gia góp ý.</p>}@foreach(var comment in Model.Comments){<div class="border-bottom py-3"><span class="small text-muted">@Ui.Time(comment.CreatedAt) · Lớp #@comment.ClassId</span><p class="preserve mb-0 mt-1">@comment.Content</p></div>}</div></section>
</div>
</div>
</div>
@if(owner){<details class="card mt-2"><summary class="card-body small fw-semibold">Thông tin sử dụng AI của buổi này</summary><div class="px-4 pb-4 small"><p>@Model.Usage.Count lần gọi, gồm cả lần thử lại. Token đầu vào đã ghi nhận: @Model.Usage.Sum(x=>x.InputTokens??0). Token đầu ra đã ghi nhận: @Model.Usage.Sum(x=>x.OutputTokens??0). Token suy luận đã ghi nhận: @Model.Usage.Sum(x=>x.ThinkingTokens??0).</p><p>Chi phí ước tính: @(Model.Usage.Count>0&&Model.Usage.All(x=>x.EstimatedCostUsd.HasValue)?Model.Usage.Sum(x=>x.EstimatedCostUsd!.Value).ToString("0.000000")+" USD":"chưa xác định — chưa có đủ bảng giá hoặc token")</p><p class="mb-0">Model: @e.Model · Prompt: @e.PromptVersion. Có @Model.Usage.Count(x=>!x.InputTokens.HasValue||!x.OutputTokens.HasValue) lần gọi chưa đủ thông tin token; tổng đã ghi nhận không coi các lần này là 0.</p></div></details>}
@section Scripts{<script id="rubricData" type="application/json">@Html.Raw(JsonSerializer.Serialize(new{labels=averages.Select(x=>x.Code switch { "accuracy"=>"Độ đúng", "depth"=>"Độ sâu", "structure"=>"Cấu trúc", "relevance"=>"Liên quan", "language"=>"Ngôn ngữ", _=>x.Name }),scores=averages.Select(x=>x.Score)}))</script>
<script>
(() => {
    let radar = null;
    const canvas = document.getElementById('rubricChart');
    if (window.Chart && window.ChartTheme && canvas) {
        const d = JSON.parse(document.getElementById('rubricData').textContent), accent = ChartTheme.token('--accent');
        radar = new Chart(canvas, { type: 'radar', data: { labels: d.labels, datasets: [{ label: 'Điểm /10', data: d.scores, borderColor: accent, backgroundColor: ChartTheme.fill('--accent'), pointBackgroundColor: accent, borderWidth: 2 }] }, options: { maintainAspectRatio: false, scales: { r: { min: 0, max: 10, ticks: { stepSize: 2 } } }, plugins: { legend: { display: false } } } });
    }
    const tabs = document.getElementById('reportTabs');
    if (!window.bootstrap || !tabs) return;
    tabs.classList.add('is-ready'); // without JS every pane stays visible (CSS fallback)
    document.getElementById('tab-overview').addEventListener('shown.bs.tab', () => radar?.resize());
    // Old links (#report-score, #report-practice, #report-answers) open the tab that holds the target, then scroll to it.
    function open() {
        const target = location.hash.length > 1 && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        const pane = target?.closest?.('.tab-pane');
        if (!pane) return;
        const button = tabs.querySelector(`[data-bs-target="#${pane.id}"]`);
        if (!pane.classList.contains('active')) { button.addEventListener('shown.bs.tab', () => target.scrollIntoView({ block: 'start' }), { once: true }); bootstrap.Tab.getOrCreateInstance(button).show(); }
        else target.scrollIntoView({ block: 'start' });
    }
    open();
    window.addEventListener('hashchange', open);
})();
</script>}
