@model AdminIndexVm
@{ ViewData["Title"] = "Quản trị hệ thống"; }
<div class="page-heading"><div><h1>Quản trị hệ thống</h1><p>Quyền truy cập, nội dung luyện tập và mức sử dụng AI.</p></div></div>
@await Html.PartialAsync("_Alerts")
<section class="page-section" aria-labelledby="systemHeading">
    <div class="section-head"><h2 id="systemHeading" class="h4 mb-0">Hệ thống &amp; thống kê</h2></div>
    <dl class="kpi-grid">
        <div class="kpi reveal" style="--i:0"><dt>Người dùng</dt><dd><span class="kpi-value" data-count="@Model.UserCount">@Model.UserCount</span><span class="kpi-unit">tài khoản</span></dd></div>
        <div class="kpi reveal" style="--i:1"><dt>Buổi phỏng vấn</dt><dd><span class="kpi-value" data-count="@Model.SessionCount">@Model.SessionCount</span><span class="kpi-unit">buổi</span></dd><dd class="kpi-hint">Mọi trạng thái, kể cả buổi chưa xong.</dd></div>
        <div class="kpi reveal" style="--i:2"><dt>Câu hỏi ngân hàng</dt><dd><span class="kpi-value" data-count="@Model.QuestionCount">@Model.QuestionCount</span><span class="kpi-unit">câu</span></dd></div>
    </dl>
    <div class="section-head mt-4"><h3 class="h5 mb-0">Hoạt động 14 ngày gần nhất</h3><span class="small text-muted">Giờ Việt Nam</span></div>
    <div class="row g-4">
        <div class="col-xl-6"><section class="card h-100" aria-labelledby="sessionsChartHeading"><div class="card-body"><h3 id="sessionsChartHeading" class="h5">Buổi luyện theo ngày</h3><div class="chart-box" style="height:240px"><canvas id="sessionsChart" role="img" aria-label="Biểu đồ đường số buổi luyện mỗi ngày trong 14 ngày gần nhất"></canvas></div></div></section></div>
        <div class="col-xl-6"><section class="card h-100" aria-labelledby="aiChartHeading"><div class="card-body"><h3 id="aiChartHeading" class="h5">Lượt gọi AI theo ngày</h3><div class="chart-box" style="height:240px"><canvas id="aiChart" role="img" aria-label="Biểu đồ cột lượt gọi AI mỗi ngày trong 14 ngày gần nhất"></canvas></div></div></section></div>
        <div class="col-xl-6"><section class="card h-100" aria-labelledby="rolesChartHeading"><div class="card-body"><h3 id="rolesChartHeading" class="h5">Người dùng theo vai trò</h3><div class="chart-box" style="height:240px"><canvas id="rolesChart" role="img" aria-label="Biểu đồ vòng số người dùng theo vai trò: @Model.UsersByRole[0] sinh viên, @Model.UsersByRole[1] giảng viên, @Model.UsersByRole[2] quản trị"></canvas></div></div></section></div>
        <div class="col-xl-6"><section class="card h-100" aria-labelledby="scoresChartHeading"><div class="card-body"><h3 id="scoresChartHeading" class="h5">Phân bố điểm các buổi đầy đủ</h3><div class="chart-box" style="height:240px"><canvas id="scoresChart" role="img" aria-label="Biểu đồ cột số buổi theo mức điểm"></canvas></div></div></section></div>
    </div>
    <details class="mt-3"><summary>Xem bảng số liệu</summary><div class="table-responsive mt-2"><table class="table table-sm"><thead><tr><th>Ngày</th><th class="num">Buổi luyện</th><th class="num">Lượt gọi AI</th></tr></thead><tbody>@for (var i = 0; i < Model.DayLabels.Count; i++) { <tr><td>@Model.DayLabels[i]</td><td class="num">@Model.SessionsPerDay[i]</td><td class="num">@Model.AiCallsPerDay[i]</td></tr> }</tbody></table></div></details>
</section>
<section class="page-section" aria-labelledby="aiHeading">
    <div class="section-head"><h2 id="aiHeading" class="h4 mb-0">Sử dụng AI</h2><a asp-controller="AiUsage" asp-action="Index" class="btn btn-secondary btn-sm">Chi tiết theo tài khoản và ngày <span class="btn-arrow" aria-hidden="true">→</span></a></div>
    <dl class="kpi-grid">
        <div class="kpi reveal" style="--i:3"><dt>Lượt gọi</dt><dd><span class="kpi-value" data-count="@Model.AiRequestCount">@Model.AiRequestCount.ToString("N0")</span><span class="kpi-unit">lượt</span></dd><dd class="kpi-hint">Gồm cả lượt thử lại.</dd></div>
        <div class="kpi reveal" style="--i:4"><dt>Token vào / ra</dt><dd><span class="kpi-value" data-count="@Model.ReportedInputTokens">@Model.ReportedInputTokens.ToString("N0")</span><span class="kpi-unit">vào</span></dd><dd><span class="kpi-value" data-count="@Model.ReportedOutputTokens">@Model.ReportedOutputTokens.ToString("N0")</span><span class="kpi-unit">ra</span></dd><dd class="kpi-hint">Chỉ số provider trả về.</dd></div>
        <div class="kpi reveal" style="--i:5"><dt>Chi phí đã biết</dt><dd><span class="kpi-value">@Model.KnownEstimatedCostUsd.ToString("0.0000")</span><span class="kpi-unit">USD</span></dd><dd class="kpi-hint">Ước tính, không phải hóa đơn. @Model.UnknownCostCount lượt chưa rõ chi phí.</dd></div>
    </dl>
</section>

@section Scripts {
    <script id="adminChartData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { days = Model.DayLabels, sessions = Model.SessionsPerDay, ai = Model.AiCallsPerDay, roles = Model.UsersByRole, bands = Model.ScoreBands }))</script>
    <script src="~/js/admin-charts.js" asp-append-version="true"></script>
}
