@model AdminIndexVm
@{ ViewData["Title"] = "Quản trị hệ thống"; }
<div class="page-heading"><div><h1>Quản trị hệ thống</h1><p>Quyền truy cập, nội dung luyện tập và mức sử dụng AI.</p></div></div>
@await Html.PartialAsync("_Alerts")
<section class="page-section" aria-labelledby="systemHeading">
    <div class="section-head"><h2 id="systemHeading" class="h4 mb-0">Hệ thống</h2></div>
    <dl class="kpi-grid">
        <div class="kpi reveal" style="--i:0"><dt>Người dùng</dt><dd><span class="kpi-value">@Model.UserCount</span><span class="kpi-unit">tài khoản</span></dd></div>
        <div class="kpi reveal" style="--i:1"><dt>Buổi phỏng vấn</dt><dd><span class="kpi-value">@Model.SessionCount</span><span class="kpi-unit">buổi</span></dd><dd class="kpi-hint">Mọi trạng thái, kể cả buổi chưa xong.</dd></div>
        <div class="kpi reveal" style="--i:2"><dt>Câu hỏi ngân hàng</dt><dd><span class="kpi-value">@Model.QuestionCount</span><span class="kpi-unit">câu</span></dd></div>
    </dl>
</section>
<section class="page-section" aria-labelledby="aiHeading">
    <div class="section-head"><h2 id="aiHeading" class="h4 mb-0">Sử dụng AI</h2><a asp-controller="AiUsage" asp-action="Index" class="btn btn-secondary btn-sm">Chi tiết theo tài khoản và ngày <span class="btn-arrow" aria-hidden="true">→</span></a></div>
    <dl class="kpi-grid">
        <div class="kpi reveal" style="--i:3"><dt>Lượt gọi</dt><dd><span class="kpi-value">@Model.AiRequestCount.ToString("N0")</span><span class="kpi-unit">lượt</span></dd><dd class="kpi-hint">Gồm cả lượt thử lại.</dd></div>
        <div class="kpi reveal" style="--i:4"><dt>Token vào / ra</dt><dd><span class="kpi-value">@Model.ReportedInputTokens.ToString("N0")</span><span class="kpi-unit">vào</span></dd><dd><span class="kpi-value">@Model.ReportedOutputTokens.ToString("N0")</span><span class="kpi-unit">ra</span></dd><dd class="kpi-hint">Chỉ số provider trả về.</dd></div>
        <div class="kpi reveal" style="--i:5"><dt>Chi phí đã biết</dt><dd><span class="kpi-value">@Model.KnownEstimatedCostUsd.ToString("0.0000")</span><span class="kpi-unit">USD</span></dd><dd class="kpi-hint">Ước tính, không phải hóa đơn. @Model.UnknownCostCount lượt chưa rõ chi phí.</dd></div>
    </dl>
</section>
