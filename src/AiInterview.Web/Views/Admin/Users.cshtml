@model AdminUsersVm
@{ ViewData["Title"] = "Quản lý người dùng"; }
<h1>Quản lý người dùng</h1>
@await Html.PartialAsync("_Nav")
@await Html.PartialAsync("_Alerts")
<p><a asp-action="CreateUser" class="btn btn-primary">Thêm người dùng</a></p>
<form asp-action="Users" method="get" class="row g-2 mb-3"><div class="col-sm-9"><label for="search" class="visually-hidden">Tên hoặc email</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo tên hoặc email" maxlength="200" /></div><div class="col-sm-3"><button class="btn btn-primary" type="submit">Tìm người dùng</button></div></form>
<p class="text-muted">Đổi vai trò hoặc khóa tài khoản sẽ thu hồi phiên đăng nhập cũ. Hệ thống bảo vệ tài khoản quản trị cuối cùng và không cho bạn tự gỡ quyền/khóa chính mình.</p>
@if (Model.HasMore) { <div class="alert alert-info">Đang hiển thị 100 kết quả đầu tiên. Tìm theo tên hoặc email để thu hẹp.</div> }
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Người dùng</th><th>Quyền hiện tại</th><th>Trạng thái</th><th>Cập nhật quyền</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var user in Model.Users)
{
    <tr><td><strong>@user.FullName</strong><br /><span class="text-muted small">@user.Email</span></td>
        <td>@string.Join(", ", user.Roles.Select(role => role == Roles.Admin ? "Quản trị" : role == Roles.Lecturer ? "Giảng viên" : "Sinh viên"))</td>
        <td><span class="badge @(user.Locked ? "bg-danger" : "bg-success")">@(user.Locked ? "Đang khóa" : "Hoạt động")</span></td>
        <td><form asp-action="UserAccess" method="post" class="d-flex flex-wrap align-items-center gap-2">
            <input type="hidden" name="UserId" value="@user.Id" /><label for="role-@user.Id" class="visually-hidden">Vai trò của @user.FullName</label>
            <select name="Role" id="role-@user.Id" class="form-select form-select-sm" style="max-width:150px">
                <option value="Student" selected="@user.Roles.Contains(Roles.Student)">Sinh viên</option>
                <option value="Lecturer" selected="@user.Roles.Contains(Roles.Lecturer)">Giảng viên</option>
                <option value="Admin" selected="@user.Roles.Contains(Roles.Admin)">Quản trị</option>
            </select>
            <div class="form-check"><input name="Locked" value="true" type="checkbox" class="form-check-input" id="lock-@user.Id" checked="@user.Locked" /><label for="lock-@user.Id" class="form-check-label">Khóa</label></div>
            <button class="btn btn-outline-primary btn-sm" type="submit">Lưu</button>
        </form></td>
        <td><div class="d-flex flex-wrap gap-2">
            <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-outline-primary btn-sm" aria-label="Sửa người dùng @user.FullName">Sửa</a>
            <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-outline-danger btn-sm" aria-label="Xóa người dùng @user.FullName">Xóa</a>
        </div></td></tr>
}
@if (Model.Users.Count == 0) { <tr><td colspan="5">Không có người dùng phù hợp.</td></tr> }
</tbody></table></div>
