@model PositionEditVm
@{ ViewData["Title"] = Model.Id == 0 ? "Thêm vị trí" : "Sửa vị trí"; }
<a asp-action="Positions" class="page-back">← Vị trí ứng tuyển</a><h1>@ViewData["Title"]</h1>
<div class="card form-narrow"><div class="card-body"><form asp-action="Position" method="post">
    <input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div>
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    <button class="btn btn-primary" type="submit">Lưu vị trí</button>
</form></div></div>
