@model List<Position>
@{ ViewData["Title"] = "Vị trí ứng tuyển"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h1>Vị trí ứng tuyển</h1><a asp-action="Position" class="btn btn-primary">Thêm vị trí</a></div>
@await Html.PartialAsync("_Nav")
@await Html.PartialAsync("_Alerts")
<p class="small text-muted">Vị trí đã được dùng trong câu hỏi, bài tập hoặc buổi phỏng vấn sẽ chuyển sang ngừng hoạt động khi xóa để giữ lịch sử.</p>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Vị trí</th><th>Mô tả</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var position in Model)
{
    <tr><td><strong>@position.Name</strong></td><td>@position.Description</td><td><span class="badge @(position.IsActive ? "bg-success" : "bg-secondary")">@(position.IsActive ? "Hoạt động" : "Đã tắt")</span></td><td><div class="d-flex gap-2"><a asp-action="Position" asp-route-id="@position.Id" class="btn btn-outline-primary btn-sm">Sửa</a><form asp-action="DeletePosition" method="post"><input type="hidden" name="id" value="@position.Id" /><button class="btn btn-outline-danger btn-sm" type="submit">Xóa / tắt</button></form></div></td></tr>
}
</tbody></table></div>
