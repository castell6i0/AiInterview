@model List<Position>
@{ ViewData["Title"] = "Vị trí ứng tuyển"; }
<div class="page-heading"><div><h1>Vị trí ứng tuyển</h1></div><a asp-action="Position" class="btn btn-primary">Thêm vị trí</a></div>
@await Html.PartialAsync("_Alerts")
<p class="small text-muted">Vị trí đã được dùng trong câu hỏi, bài tập hoặc buổi phỏng vấn sẽ chuyển sang ngừng hoạt động khi xóa để giữ lịch sử.</p>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Vị trí</th><th>Mô tả</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var position in Model)
{
    <tr><td><strong>@position.Name</strong></td><td>@position.Description</td><td><span class="pill @(position.IsActive ? "pill-ok" : "pill-off")">@(position.IsActive ? "Hoạt động" : "Đã tắt")</span></td><td><button type="button" class="menu-dots" popovertarget="menu-p@(position.Id)" style="anchor-name:--menu-p@(position.Id)" aria-label="Thao tác cho vị trí @position.Name"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-more-v" /></svg></button><div id="menu-p@(position.Id)" popover class="glass-pop row-menu" style="position-anchor:--menu-p@(position.Id)"><a asp-action="Position" asp-route-id="@position.Id" class="row-menu-item"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-edit" /></svg>Sửa</a><form asp-action="DeletePosition" method="post"><input type="hidden" name="id" value="@position.Id" /><button class="row-menu-item is-danger" type="submit"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-trash" /></svg>Xóa / tắt</button></form></div></td></tr>
}
</tbody></table></div>
