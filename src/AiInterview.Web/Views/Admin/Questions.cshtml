@model AdminQuestionsVm
@{ ViewData["Title"] = "Ngân hàng câu hỏi"; }
<div class="page-heading"><div><h1>Ngân hàng câu hỏi</h1></div></div>
@await Html.PartialAsync("_Alerts")
<form asp-action="Questions" method="get" class="toolbar mb-4">
    <label for="search" class="visually-hidden">Nội dung, kỹ năng hoặc loại công ty</label><input id="search" name="search" value="@Model.Search" class="form-control toolbar-grow" placeholder="Nội dung, kỹ năng hoặc loại công ty" maxlength="200" />
    <label asp-for="PositionId" class="visually-hidden">Vị trí</label><select asp-for="PositionId" asp-items="@(new SelectList(Model.Positions, "Id", "Name"))" class="form-select toolbar-select"><option value="">Tất cả vị trí</option></select>
    <button class="btn btn-secondary" type="submit">Lọc câu hỏi</button><a asp-action="Question" class="btn btn-primary">Thêm câu hỏi</a>
</form>
@foreach (var question in Model.Questions)
{
    <div class="card mb-3"><div class="card-body"><div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div class="flex-grow-1"><p class="text-muted small mb-2">@question.Position.Name · @ClassroomUi.Label(question.Level) · @ClassroomUi.Label(question.Language) · @ClassroomUi.Label(question.Kind) · @question.CompanyType</p><p class="preserve">@question.Content</p>
            <div class="d-flex flex-wrap gap-1">@foreach (var tag in question.Tags) { <span class="tag">@tag.Skill.Name</span> } <span class="pill @(question.IsActive ? "pill-ok" : "pill-off")">@(question.IsActive ? "Đang dùng" : "Đã tắt")</span></div>
        </div><button type="button" class="menu-dots" popovertarget="menu-q@(question.Id)" style="anchor-name:--menu-q@(question.Id)" aria-label="Thao tác cho câu hỏi #@question.Id"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-more-v" /></svg></button><div id="menu-q@(question.Id)" popover class="glass-pop row-menu" style="position-anchor:--menu-q@(question.Id)"><a asp-action="Question" asp-route-id="@question.Id" class="row-menu-item"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-edit" /></svg>Sửa</a><form asp-action="DeleteQuestion" method="post"><input name="id" type="hidden" value="@question.Id" /><button class="row-menu-item is-danger" type="submit"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-trash" /></svg>Xóa</button></form></div>
    </div></div></div>
}
@if (Model.Questions.Count == 0) { <p>Không tìm thấy câu hỏi phù hợp.</p> }
<nav class="d-flex align-items-center justify-content-between mt-4" aria-label="Phân trang câu hỏi">
    @if (Model.Page > 1) { <a asp-action="Questions" asp-route-search="@Model.Search" asp-route-positionId="@Model.PositionId" asp-route-page="@(Model.Page - 1)" class="btn btn-secondary">← Trang trước</a> } else { <span></span> }
    <span>Trang @Model.Page / @Model.TotalPages</span>
    @if (Model.Page < Model.TotalPages) { <a asp-action="Questions" asp-route-search="@Model.Search" asp-route-positionId="@Model.PositionId" asp-route-page="@(Model.Page + 1)" class="btn btn-secondary">Trang sau →</a> } else { <span></span> }
</nav>
