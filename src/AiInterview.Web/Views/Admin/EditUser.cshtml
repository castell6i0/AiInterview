@model EditUserVm
@{ ViewData["Title"] = "Sửa người dùng"; }
<a asp-action="Users" class="page-back">← Quản lý người dùng</a>
<h1>Sửa người dùng</h1>
@await Html.PartialAsync("_Alerts")
<div class="card form-narrow"><div class="card-body">
    <form asp-action="EditUser" method="post">
        <input asp-for="UserId" type="hidden" />
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="FullName" class="form-label">Họ và tên</label>
            <input asp-for="FullName" class="form-control" autocomplete="name" required />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" type="email" class="form-control" autocomplete="username" required />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" type="submit">Lưu người dùng</button>
            <a asp-action="Users" class="btn btn-secondary">Hủy</a>
        </div>
    </form>
</div></div>
