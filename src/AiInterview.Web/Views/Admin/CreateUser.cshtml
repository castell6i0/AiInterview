@model CreateUserVm
@{ ViewData["Title"] = "Thêm người dùng"; }
<a asp-action="Users" class="page-back">← Quản lý người dùng</a>
<h1>Thêm người dùng</h1>
@await Html.PartialAsync("_Alerts")
<div class="card form-narrow"><div class="card-body">
    <form asp-action="CreateUser" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="FullName" class="form-label">Họ và tên</label>
            <input asp-for="FullName" class="form-control" autocomplete="name" required />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" type="email" class="form-control" autocomplete="username" required />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Role" class="form-label">Vai trò</label>
            <select asp-for="Role" class="form-select" required>
                <option value="Student">Sinh viên</option>
                <option value="Lecturer">Giảng viên</option>
                <option value="Admin">Quản trị</option>
            </select>
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">Mật khẩu</label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" minlength="10" aria-describedby="password-hint" required />
            <div id="password-hint" class="form-text">Ít nhất 10 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.</div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" minlength="10" required />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" type="submit">Tạo người dùng</button>
            <a asp-action="Users" class="btn btn-secondary">Hủy</a>
        </div>
    </form>
</div></div>
