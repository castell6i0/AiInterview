@model DeleteUserVm
@{ ViewData["Title"] = "Xóa người dùng"; }
<a asp-action="Users" class="btn btn-secondary btn-sm">← Quản lý người dùng</a>
<h1 class="mt-3">Xóa người dùng</h1>
@await Html.PartialAsync("_Alerts")
<div class="card form-narrow"><div class="card-body">
    <dl class="row">
        <dt class="col-sm-3">Họ và tên</dt><dd class="col-sm-9">@Model.FullName</dd>
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    </dl>
    <form asp-action="DeleteUser" method="post">
        <input asp-for="UserId" type="hidden" />
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        @if (Model.CanDelete)
        {
            <div class="alert alert-warning" role="alert">Bạn có chắc muốn xóa tài khoản này? Thao tác này không thể hoàn tác.</div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-danger" type="submit">Xác nhận xóa người dùng</button>
                <a asp-action="Users" class="btn btn-secondary">Hủy</a>
            </div>
        }
        else
        {
            <div class="alert alert-warning" role="alert"><strong>Không thể xóa tài khoản này.</strong> @Model.RefusalReason</div>
            <a asp-action="Users" class="btn btn-secondary">Quay lại danh sách</a>
        }
    </form>
</div></div>
